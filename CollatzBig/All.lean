/-- Any cycle not containing `1` has at least `12276` odd steps. -/
theorem odds_card_ge {n p : ℕ} (hc : IsCycle n p) (hnr : ¬ ReachesOne n) :
    12276 ≤ (odds n p).card :=
  odds_card_ge_of_check2 hc hnr (by norm_num) reachesOne_below (kall_of_kallFrom_zero cycAll)

theorem log2_three_pow : Nat.log2 (3 ^ 12276) = 19456 := by decide +kernel

/-- Any cycle not containing `1` has at least `19457` even steps. -/
theorem evens_card_ge {n p : ℕ} (hc : IsCycle n p) (hnr : ¬ ReachesOne n) :
    19457 ≤ (evens n p).card := by
  have h := evens_card_ge_of_odds hc (odds_card_ge hc hnr)
  rw [log2_three_pow] at h
  exact h

/-- Any cycle not containing `1` has length at least `31733`. -/
theorem cycle_length_ge {n p : ℕ} (hc : IsCycle n p) (hnr : ¬ ReachesOne n) :
    31733 ≤ p := by
  have h1 := odds_card_ge hc hnr
  have h2 := evens_card_ge hc hnr
  have := card_evens_add_card_odds n p
  omega

