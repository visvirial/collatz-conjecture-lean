theorem descends_below : ∀ n, 2 ≤ n → n < 16777216 → Descends n := by
  have h := descends_of_resCheck (k := 16) (M := 256) (fuel := 1000)
    (fun r hr => kall_of_kallFrom resAll r (by norm_num at hr ⊢; omega))
  intro n h2 hn
  exact h n h2 (by norm_num; omega)

theorem reachesOne_below : ∀ n, 1 ≤ n → n < 16777216 → ReachesOne n := by
  intro n h1 hn
  exact reachesOne_of_descends_below 16777215 (fun m hm hm' => descends_below m hm (by omega))
    n h1 (by omega)

