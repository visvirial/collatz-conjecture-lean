import Collatz.Krasikov
import Collatz.Kernel

/-!
# At least `N^(303/625)` integers up to `N` reach 1 (Krasikov's method mod `3^9`)

`Collatz/Krasikov.lean` with the modulus, the exponent and the weights as parameters.
Constants `C r` on the residues mod `M` (`3 ∣ M`) and integer weights `W a` form a certificate if

* (`KGWeights`) `W a / 2^k ≤ (3 / 2^a)^(u/v)` for `a ≤ A`, checked as
  `W a ^ v * 2^(a u) ≤ 3^u * 2^(k v)`;
* (`KGCert`) for every `s < 3M` prime to `3`, `C (s % M) * 2^k ≤ ∑ C (child % M) * W a`, the sum
  over `2 ≤ a ≤ A` with `2^a s ≡ 4, 7 (mod 9)` (the residue of the child mod `M` only depends on
  `s` mod `3M`).

Then, by induction on `x - m` as in `Collatz/Krasikov.lean`, `C (m % M) (x/m)^(u/v)` is bounded
by a constant times `#backTree m x`, and so at least `κ N^(u/v)` integers `n ≤ N` reach `1`.

The instance uses `M = 3^9`, `A = 30`, `k = 40` and `u/v = 303/625 = 0.4848`
(`scripts/krasikov_gen_cert.py 9 30 40 303 625 800`; the constants are packed into one natural
number with 21 bits per residue, and the certificate is checked by `decide +kernel` in 27 pieces).
This improves the exponent `3/7 ≈ 0.4286` of `card_reachesOne_ge_three_sevenths`. For this
scheme the best exponent with constants mod `3^h` is about `0.4356, 0.4499, 0.4602, 0.4701,
0.4771, 0.4815, 0.4849` for `h = 3, …, 9`; larger `h` would make the kernel check too slow.
-/

namespace Collatz

open Finset

/-! ## The certificate -/

/-- `ksum f n = f 0 + ⋯ + f (n - 1)`, by plain recursion (cheap in the kernel). -/
def ksum (f : ℕ → ℕ) (n : ℕ) : ℕ := Nat.rec (motive := fun _ => ℕ) 0 (fun i acc => acc + f i) n

lemma ksum_eq (f : ℕ → ℕ) : ∀ n, ksum f n = ∑ i ∈ range n, f i
  | 0 => rfl
  | n + 1 => by
    rw [sum_range_succ, ← ksum_eq f n]
    rfl

/-- The exponent `a` is used at a node `≡ s`: `a ≥ 2` and the child is an integer prime to `3`. -/
def kgB (s a : ℕ) : Bool :=
  Nat.ble 2 a && (Nat.beq ((2 ^ a * s) % 9) 4 || Nat.beq ((2 ^ a * s) % 9) 7)

lemma kgB_iff (s a : ℕ) : kgB s a = true ↔ 2 ≤ a ∧ condB s a := by
  simp [kgB, condB]

/-- The term of exponent `a` at a node `≡ s (mod 3M)`. -/
def kgTerm (C W : ℕ → ℕ) (M s a : ℕ) : ℕ :=
  cond (kgB s a) (C (((2 ^ a * s) % (3 * M) - 1) / 3 % M) * W a) 0

/-- The step inequality for every residue mod `3M` prime to `3`. -/
def KGCert (C W : ℕ → ℕ) (M A k : ℕ) : Prop :=
  ∀ s < 3 * M, s % 3 ≠ 0 → C (s % M) * 2 ^ k ≤ ksum (kgTerm C W M s) (A + 1)

/-- `W a / 2^k ≤ (3 / 2^a)^(u/v)` for `a ≤ A`, in integer form. -/
def KGWeights (W : ℕ → ℕ) (A k u v : ℕ) : Prop :=
  ∀ a ≤ A, W a ^ v * 2 ^ (a * u) ≤ 3 ^ u * 2 ^ (k * v)

section Gen

variable {C W : ℕ → ℕ} {M A k u v : ℕ}

lemma kgB_mod (h3 : 3 ∣ M) (m a : ℕ) : kgB (m % (3 * M)) a = kgB m a := by
  have h9 : 9 ∣ 3 * M := by obtain ⟨j, rfl⟩ := h3; exact ⟨j, by ring⟩
  have : (2 ^ a * (m % (3 * M))) % 9 = (2 ^ a * m) % 9 := by
    rw [Nat.mul_mod, Nat.mod_mod_of_dvd m h9, ← Nat.mul_mod]
  simp only [kgB, this]

lemma kg_index (h3 : 3 ∣ M) {m a : ℕ} (hc : condB m a) :
    ((2 ^ a * (m % (3 * M))) % (3 * M) - 1) / 3 % M = child m a % M := by
  have h9 : 9 ∣ 3 * M := by obtain ⟨j, rfl⟩ := h3; exact ⟨j, by ring⟩
  rw [Nat.mul_mod, Nat.mod_mod, ← Nat.mul_mod]
  unfold child
  unfold condB at hc
  set n := 2 ^ a * m
  have hd : 3 * M * (n / (3 * M)) + n % (3 * M) = n := Nat.div_add_mod n (3 * M)
  have ht : n % (3 * M) % 9 = n % 9 := Nat.mod_mod_of_dvd n h9
  have e : (n - 1) / 3 = (n % (3 * M) - 1) / 3 + M * (n / (3 * M)) := by
    have e3 : 3 * M * (n / (3 * M)) = 3 * (M * (n / (3 * M))) := by ring
    rw [e3] at hd
    generalize M * (n / (3 * M)) = Y at hd ⊢
    generalize n % (3 * M) = t at hd ht ⊢
    omega
  rw [e, Nat.add_mul_mod_self_left]

/-- The weights as real lower bounds. -/
lemma kg_w_lower (hv : 0 < v) (hW : KGWeights W A k u v) {a : ℕ} (ha : a ≤ A) :
    (W a : ℝ) ≤ ((3 : ℝ) / 2 ^ a) ^ ((u : ℝ) / v) * 2 ^ k := by
  rw [← div_le_iff₀ (by positivity)]
  have h1 : (0 : ℝ) ≤ (W a : ℝ) / 2 ^ k := by positivity
  have h2 : (0 : ℝ) ≤ ((3 : ℝ) / 2 ^ a) ^ ((u : ℝ) / v) := by positivity
  refine (pow_le_pow_iff_left₀ h1 h2 (by omega : v ≠ 0)).1 ?_
  have e : (((3 : ℝ) / 2 ^ a) ^ ((u : ℝ) / v)) ^ v = ((3 : ℝ) / 2 ^ a) ^ u := by
    rw [← Real.rpow_natCast, ← Real.rpow_mul (by positivity),
      div_mul_cancel₀ (u : ℝ) (by exact_mod_cast hv.ne' : (v : ℝ) ≠ 0), Real.rpow_natCast]
  rw [e, div_pow, div_pow, ← pow_mul, ← pow_mul, div_le_div_iff₀ (by positivity) (by positivity)]
  have := hW a ha
  have : ((W a ^ v * 2 ^ (a * u) : ℕ) : ℝ) ≤ ((3 ^ u * 2 ^ (k * v) : ℕ) : ℝ) := by
    exact_mod_cast this
  push_cast at this
  simpa [mul_comm] using this

/-- The certificate as a real inequality at a node `m`. -/
lemma kgCert_real (hM : 0 < M) (h3 : 3 ∣ M) (hv : 0 < v) (hc : KGCert C W M A k)
    (hW : KGWeights W A k u v) {m : ℕ} (hm : m % 3 ≠ 0) :
    (C (m % M) : ℝ) ≤ ∑ a ∈ (range (A + 1)).filter (fun a => 2 ≤ a ∧ condB m a),
      (C (child m a % M) : ℝ) * ((3 : ℝ) / 2 ^ a) ^ ((u : ℝ) / v) := by
  have hT : 0 < 3 * M := by omega
  have h3T : M ∣ 3 * M := dvd_mul_left M 3
  have hs := hc (m % (3 * M)) (Nat.mod_lt _ hT) (by
    rw [Nat.mod_mod_of_dvd m (dvd_mul_right 3 M)]; exact hm)
  rw [Nat.mod_mod_of_dvd m h3T, ksum_eq] at hs
  have hR : ((C (m % M) * 2 ^ k : ℕ) : ℝ) ≤
      ((∑ a ∈ range (A + 1), kgTerm C W M (m % (3 * M)) a : ℕ) : ℝ) := by
    exact_mod_cast hs
  push_cast at hR
  have hk : (0 : ℝ) < 2 ^ k := by positivity
  refine le_of_mul_le_mul_right ?_ hk
  refine hR.trans ?_
  rw [sum_filter, sum_mul]
  refine sum_le_sum (fun a ha => ?_)
  have haA : a ≤ A := by simp at ha; omega
  unfold kgTerm
  by_cases h : 2 ≤ a ∧ condB m a
  · have hb : kgB (m % (3 * M)) a = true := by rw [kgB_mod h3, kgB_iff]; exact h
    simp only [hb, h.1, h.2, and_self, Bool.cond_true, ↓reduceIte]
    rw [kg_index h3 h.2]
    push_cast
    rw [mul_assoc]
    exact mul_le_mul_of_nonneg_left (kg_w_lower hv hW haA) (by positivity)
  · have hb : ¬ kgB (m % (3 * M)) a = true := by rw [kgB_mod h3, kgB_iff]; exact h
    rw [Bool.not_eq_true] at hb
    simp only [hb, h, Bool.cond_false, ↓reduceIte]
    simp

/-- `#backTree m x ≥ ∑ #backTree (child) x` over the good exponents `a ≤ A`. -/
lemma card_backTree_ge_gen {m x : ℕ} (A : ℕ) (hm1 : m % 2 = 1) (hNP : notSyracusePeriodic m) :
    ∑ a ∈ (range (A + 1)).filter (fun a => 2 ≤ a ∧ condB m a), (backTree (child m a) x).card ≤
      (backTree m x).card := by
  classical
  set S := (range (A + 1)).filter (fun a => 2 ≤ a ∧ condB m a)
  have hprops : ∀ a ∈ S, 3 * child m a + 1 = 2 ^ a * m ∧ syracuse (child m a) = m := by
    intro a ha
    simp only [S, mem_filter] at ha
    obtain ⟨h1, -, -, h2, -⟩ := child_props hm1 hNP ha.2.1 ha.2.2
    exact ⟨h1, h2⟩
  have hinj : ∀ a ∈ S, ∀ b ∈ S, child m a = child m b → a = b := by
    intro a ha b hb h
    have e1 := (hprops a ha).1
    have e2 := (hprops b hb).1
    rw [h] at e1
    have hmpos : 0 < m := by omega
    exact Nat.pow_right_injective (le_refl 2) (Nat.eq_of_mul_eq_mul_right hmpos (e1.symm.trans e2))
  rw [← card_biUnion]
  · exact card_le_card (biUnion_subset.2 (fun a ha => backTree_subset (hprops a ha).2))
  · intro a ha b hb hab
    exact backTree_disjoint hNP (hprops a ha).2 (hprops b hb).2 (fun h => hab (hinj a ha b hb h))

/-- The constant on the right. -/
noncomputable def kgBig (C : ℕ → ℕ) (M A u v : ℕ) : ℝ :=
  (∑ r ∈ range M, (C r : ℝ)) * ((2 : ℝ) ^ A) ^ ((u : ℝ) / v)

theorem kg_main_bound (hM : 0 < M) (h3 : 3 ∣ M) (hv : 0 < v) (hc : KGCert C W M A k)
    (hW : KGWeights W A k u v) (x : ℕ) :
    ∀ d m, x - m = d → m ≤ x → m % 2 = 1 → m % 3 ≠ 0 → notSyracusePeriodic m →
      (C (m % M) : ℝ) * ((x : ℝ) / m) ^ ((u : ℝ) / v) ≤ kgBig C M A u v * (backTree m x).card := by
  intro d
  induction d using Nat.strong_induction_on with
  | _ d ih =>
  intro m hd hmx hm1 hm3 hNP
  set ce : ℝ := (u : ℝ) / v with hce_def
  have hmpos : (0 : ℝ) < m := by have : 0 < m := by omega
                                 exact_mod_cast this
  have hce : (0 : ℝ) ≤ ce := by positivity
  have hxm : (0 : ℝ) ≤ (x : ℝ) / m := by positivity
  have hBig : 0 ≤ kgBig C M A u v := by unfold kgBig; positivity
  have hcard1 : (1 : ℝ) ≤ (backTree m x).card := by
    have : 1 ≤ (backTree m x).card := card_pos.2 ⟨m, self_mem_backTree hm1 hmx⟩
    exact_mod_cast this
  by_cases hsmall : x * 3 < 2 ^ A * m
  · -- base case: the ratio is below 2^A
    have hC : (C (m % M) : ℝ) ≤ ∑ r ∈ range M, (C r : ℝ) :=
      single_le_sum (f := fun r => (C r : ℝ)) (fun _ _ => by positivity)
        (mem_range.2 (Nat.mod_lt _ hM))
    have hr : (x : ℝ) / m ≤ 2 ^ A := by
      rw [div_le_iff₀ hmpos]
      have : (x : ℝ) * 3 < 2 ^ A * m := by exact_mod_cast hsmall
      nlinarith
    have hp : ((x : ℝ) / m) ^ ce ≤ ((2 : ℝ) ^ A) ^ ce := Real.rpow_le_rpow hxm hr hce
    calc (C (m % M) : ℝ) * ((x : ℝ) / m) ^ ce ≤ (∑ r ∈ range M, (C r : ℝ)) * ((2 : ℝ) ^ A) ^ ce :=
          mul_le_mul hC hp (by positivity) (by positivity)
      _ = kgBig C M A u v * 1 := by rw [kgBig, mul_one]
      _ ≤ kgBig C M A u v * (backTree m x).card := mul_le_mul_of_nonneg_left hcard1 hBig
  · push Not at hsmall
    set S := (range (A + 1)).filter (fun a => 2 ≤ a ∧ condB m a)
    have hchild : ∀ a ∈ S, (C (child m a % M) : ℝ) * ((3 : ℝ) / 2 ^ a) ^ ce * ((x : ℝ) / m) ^ ce ≤
        kgBig C M A u v * (backTree (child m a) x).card := by
      intro a ha
      have ha' := ha
      simp only [S, mem_filter, mem_range] at ha'
      obtain ⟨h3c, hc1, hc3, -, hcNP, hlt⟩ := child_props hm1 hNP ha'.2.1 ha'.2.2
      have hpa : 2 ^ a * m ≤ 2 ^ A * m :=
        Nat.mul_le_mul_right m (Nat.pow_le_pow_right (by norm_num) (by omega))
      have hcx : child m a ≤ x := by omega
      have hIH := ih (x - child m a) (by omega) (child m a) rfl hcx hc1 hc3 hcNP
      have hcpos : (0 : ℝ) < child m a := by have : 0 < child m a := by omega
                                             exact_mod_cast this
      have hratio : (3 : ℝ) / 2 ^ a * ((x : ℝ) / m) ≤ (x : ℝ) / child m a := by
        have h3R : (3 : ℝ) * child m a + 1 = 2 ^ a * m := by exact_mod_cast h3c
        rw [div_mul_div_comm, div_le_div_iff₀ (by positivity) hcpos]
        have hx0 : (0 : ℝ) ≤ x := by positivity
        nlinarith
      calc (C (child m a % M) : ℝ) * ((3 : ℝ) / 2 ^ a) ^ ce * ((x : ℝ) / m) ^ ce
          = (C (child m a % M) : ℝ) * ((3 : ℝ) / 2 ^ a * ((x : ℝ) / m)) ^ ce := by
            rw [Real.mul_rpow (by positivity) hxm, mul_assoc]
        _ ≤ (C (child m a % M) : ℝ) * ((x : ℝ) / child m a) ^ ce :=
            mul_le_mul_of_nonneg_left (Real.rpow_le_rpow (by positivity) hratio hce) (by positivity)
        _ ≤ _ := hIH
    calc (C (m % M) : ℝ) * ((x : ℝ) / m) ^ ce
        ≤ (∑ a ∈ S, (C (child m a % M) : ℝ) * ((3 : ℝ) / 2 ^ a) ^ ce) * ((x : ℝ) / m) ^ ce :=
          mul_le_mul_of_nonneg_right (kgCert_real hM h3 hv hc hW hm3) (by positivity)
      _ = ∑ a ∈ S, (C (child m a % M) : ℝ) * ((3 : ℝ) / 2 ^ a) ^ ce * ((x : ℝ) / m) ^ ce := by
          rw [sum_mul]
      _ ≤ ∑ a ∈ S, kgBig C M A u v * (backTree (child m a) x).card := sum_le_sum hchild
      _ = kgBig C M A u v * ((∑ a ∈ S, (backTree (child m a) x).card : ℕ) : ℝ) := by
          rw [← mul_sum]; push_cast; rfl
      _ ≤ kgBig C M A u v * (backTree m x).card := by
          apply mul_le_mul_of_nonneg_left _ hBig
          exact_mod_cast card_backTree_ge_gen A hm1 hNP

open Classical in
/-- **Krasikov-type bound from any certificate**: at least `κ N^(u/v)` integers `n ≤ N`
reach `1`. -/
theorem card_reachesOne_ge_gen (hM : 0 < M) (h3 : 3 ∣ M) (hv : 0 < v) (hc : KGCert C W M A k)
    (hW : KGWeights W A k u v) (h5 : 0 < C (5 % M)) :
    ∃ κ : ℝ, 0 < κ ∧ ∀ N : ℕ, 5 ≤ N →
      κ * (N : ℝ) ^ ((u : ℝ) / v) ≤ (((range (N + 1)).filter ReachesOne).card : ℝ) := by
  set ce : ℝ := (u : ℝ) / v with hce_def
  have hR5 : ReachesOne 5 := ⟨5, rfl⟩
  have h5R : (0 : ℝ) < C (5 % M) := by exact_mod_cast h5
  have hK : 0 < kgBig C M A u v := by
    unfold kgBig
    have : (C (5 % M) : ℝ) ≤ ∑ r ∈ range M, (C r : ℝ) :=
      single_le_sum (f := fun r => (C r : ℝ)) (fun _ _ => by positivity)
        (mem_range.2 (Nat.mod_lt _ hM))
    have : (0 : ℝ) < ∑ r ∈ range M, (C r : ℝ) := by linarith
    positivity
  have h5pos : (0 : ℝ) < (5 : ℝ) ^ ce := by positivity
  refine ⟨(C (5 % M) : ℝ) / (kgBig C M A u v * (5 : ℝ) ^ ce), by positivity, fun N hN => ?_⟩
  have hmain := kg_main_bound hM h3 hv hc hW N (N - 5) 5 rfl hN (by norm_num) (by norm_num)
    notSyracusePeriodic_five
  have hsub : backTree 5 N ⊆ (range (N + 1)).filter ReachesOne := by
    intro n hn
    rw [mem_backTree] at hn
    obtain ⟨h1, h2, j, hj⟩ := hn
    simp only [mem_filter, mem_range]
    exact ⟨by omega, reachesOne_of_syracuse_iterate hR5 j n h2 hj⟩
  have hcard : ((backTree 5 N).card : ℝ) ≤ (((range (N + 1)).filter ReachesOne).card : ℝ) := by
    exact_mod_cast card_le_card hsub
  have e : ((N : ℝ) / (5 : ℕ)) ^ ce = (N : ℝ) ^ ce / (5 : ℝ) ^ ce := by
    rw [Real.div_rpow (by positivity) (by norm_num)]; norm_num
  rw [e] at hmain
  calc (C (5 % M) : ℝ) / (kgBig C M A u v * (5 : ℝ) ^ ce) * (N : ℝ) ^ ce
      = ((C (5 % M) : ℝ) * ((N : ℝ) ^ ce / (5 : ℝ) ^ ce)) / kgBig C M A u v := by
        field_simp
    _ ≤ (kgBig C M A u v * (backTree 5 N).card) / kgBig C M A u v :=
        div_le_div_of_nonneg_right hmain hK.le
    _ = (backTree 5 N).card := by field_simp
    _ ≤ _ := hcard

end Gen

/-! ## Checking a certificate in the kernel

The checked functions use `Nat.add`, `Nat.mul`, ... directly rather than through the type
classes, which makes kernel reduction about three times faster; they agree with the functions
above by `rfl`. -/

/-- Entry `r` of a table packed with `w` bits per entry. -/
def kgTab (B w r : ℕ) : ℕ := Nat.mod (Nat.shiftRight B (Nat.mul w r)) (Nat.pow 2 w)

/-- `kgTerm C W M s a`, kernel form. -/
def kgTermR (C W : ℕ → ℕ) (M s a : ℕ) : ℕ :=
  cond (Nat.ble 2 a && (Nat.beq (Nat.mod (Nat.mul (Nat.pow 2 a) s) 9) 4 ||
      Nat.beq (Nat.mod (Nat.mul (Nat.pow 2 a) s) 9) 7))
    (Nat.mul (C (Nat.mod (Nat.div (Nat.sub (Nat.mod (Nat.mul (Nat.pow 2 a) s) (Nat.mul 3 M)) 1) 3)
      M)) (W a)) 0

/-- `ksum`, kernel form. -/
def ksumR (f : ℕ → ℕ) (n : ℕ) : ℕ :=
  Nat.rec (motive := fun _ => ℕ) 0 (fun i acc => Nat.add acc (f i)) n

/-- The certificate condition at `s`, as a `Bool`. -/
def kgOk (C W : ℕ → ℕ) (M A k s : ℕ) : Bool :=
  Nat.beq (Nat.mod s 3) 0 ||
    Nat.ble (Nat.mul (C (Nat.mod s M)) (Nat.pow 2 k)) (ksumR (kgTermR C W M s) (A + 1))

lemma kgOk_eq (C W : ℕ → ℕ) (M A k s : ℕ) : kgOk C W M A k s =
    (Nat.beq (s % 3) 0 || Nat.ble (C (s % M) * 2 ^ k) (ksum (kgTerm C W M s) (A + 1))) :=
  rfl

lemma kgCert_of_kall {C W : ℕ → ℕ} {M A k : ℕ} (hk : kall (kgOk C W M A k) (3 * M) = true) :
    KGCert C W M A k := by
  intro s hs h3
  have := kall_spec hk s hs
  simp only [kgOk_eq, Bool.or_eq_true, Nat.ble_eq] at this
  rcases this with h | h
  · exact absurd (Nat.eq_of_beq_eq_true h) h3
  · exact h

/-- The weight condition at `a`, as a `Bool`. -/
def kgWOk (W : ℕ → ℕ) (k u v a : ℕ) : Bool := Nat.ble (W a ^ v * 2 ^ (a * u)) (3 ^ u * 2 ^ (k * v))

lemma kgWeights_of_kall {W : ℕ → ℕ} {A k u v : ℕ} (hk : kall (kgWOk W k u v) (A + 1) = true) :
    KGWeights W A k u v := by
  intro a ha
  have := kall_spec hk a (by omega)
  simpa [kgWOk] using this

