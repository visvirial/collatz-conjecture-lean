/-- The weights `W a ≤ 2^40 (3/2^a)^(303/625)` for `a ≤ 30` (41 bits each). -/
def KGW : ℕ := 

theorem kgw9 : KGWeights (kgTab KGW 41) 30 40 303 625 := by
  apply kgWeights_of_kall
  decide +kernel

