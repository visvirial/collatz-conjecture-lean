import Mathlib
import Collatz.Basic
import Collatz.ApplegateLagariasSemigroup.Cert

/-!
# The 3x+1 semigroup (Applegate–Lagarias)

D. Applegate and J. C. Lagarias, *The 3x+1 semigroup*, J. Number Theory 117 (2006), 146–159
(arXiv: math/0411140; the bibliography of some versions misprints the volume as 177).

Let `S3` be the multiplicative semigroup (here: submonoid) of `ℚ` generated by `2` and the
fractions `(2k+1)/(3k+2)`, `k ≥ 0`, and let `Wild = S3⁻¹`, generated by `1/2` and
`(3k+2)/(2k+1)`. For `n ≥ 1` the fraction `n / T n` (with `T` the accelerated 3x+1 map) is a
generator of `S3`, so `n ∈ S3` as soon as `T n ∈ S3`; in particular every `n` that reaches `1`
lies in `S3` (`mem_S3_of_reachesOne`). Note that `S3` is generated by these fractions, *not* by
the maps `x ↦ 2x`, `x ↦ (3x+1)/2`.

**Theorem 1.1** (`mem_S3_iff`): `S3` is exactly the set of positive rationals whose reduced
denominator is prime to `3`. In particular (`weak_conjecture`) every positive integer lies in
`S3` (Farkas' weak 3x+1 conjecture), and (`wild_numbers`) the integers in `Wild` are exactly the
`m ≥ 1` with `3 ∤ m` (Lagarias' wild numbers conjecture). The 3x+1 conjecture implies the weak
conjecture (`mem_S3_of_reachesOne`), but not conversely.

## Proof

The easy inclusion (`S3_subset`) is a closure induction with `(q r).den ∣ q.den r.den`.

For the hard inclusion we follow the paper, with a few simplifications of the bookkeeping.
Everything is proved by one induction on `N` (`main`) of the statement
"every `1 ≤ n ≤ N` lies in `S3`, and every `m ≥ 1` with `3 ∤ m` and `128 m ≤ N` lies in `Wild`".
The tools are: `x ∈ S3` if `w x ∈ S3` for some `w ∈ Wild` (`mem_S3_of_mul_wild`), and
`n ∈ S3` if `T n ∈ S3`.

* **Lemma 3.1** (`lemma_3_1`): `H = {5, 7, 11, 13, 23, 29, 43} ⊆ Wild`, by the explicit products
  of Table 3 (the row for `13` as printed has `g(5)^3`; the identity holds with `g(5)^1`).
* **Lemma 2.1** (`lemma_2_1`): for `x > 1`, `x ≢ -1 (mod 4096)` there is `s ∈ Wild` with
  `s x ∈ ℕ` and `s x ≤ 76/79 x`. The 28 class/path rows of Tables 1–2 are checked by symbolic
  affine tracking of `2^K m + s` under `T` and multiplication by elements of `H`
  (`Collatz.ALSemigroup.alRowsOK`, `alCover`, by `decide +kernel`).
* **Lemma 2.2** (`lemma_2_2`): for `j ≡ 1, 5 (mod 6)`, `j ≤ k` and `x ≡ -1 (mod 2^k)`,
  `T^j(((2^j+1)/3) x) = x + (x+1)/2^j`; multiplicatively (`lemma_2_2_S3`):
  if `3w = 2^j + 1`, `3 w x + 1 = 2^j y`, `w ∈ Wild` and `y ∈ S3`, then `x ∈ S3`.
* **Lemma 2.3** (`lemma_2_3`, in a modified form): for `x ≡ -1 (mod 4096)` there is `1 ≤ z < x`
  with `z ∈ S3 → x ∈ S3`, provided all `m` with `3 ∤ m` and `128 m < x` are wild. With
  `x + 1 = 2^k c`, `c` odd, we take `j = 7` (so `w = 43 ∈ H`) if `k ≤ 18` and otherwise some
  `j ∈ [k-11, k-8]` with `j ≡ 1, 5 (mod 6)`; then `y = x + (x+1)/2^j ≢ -1 (mod 4096)` and
  Lemma 2.1 applied to `y` gives `z ≤ 76/79 y < x`. (The paper instead carries the bound
  `1235/1264` through an induction on `k`; the single induction on `N` makes this unnecessary.)
* **Lemma 3.2** (`lemma_3_2`, in a modified form): a prime `q ≥ 2^15` is wild if all primes
  `5 ≤ p < q` are wild and all `1 ≤ n ≤ 128 q` lie in `S3`. As in the paper, the set `Σ_q` of
  `q`-smooth `s < 6q` prime to `6q` has more than `q - 1` elements, so (pigeonhole in
  `(ZMod (6q))ˣ`) `s₁ s₂ ≡ r (mod 6q)` for some `s₁, s₂ ∈ Σ_q`, where `q ∣ 3r + 1`; with
  `N = s₁ s₂` and `q t = 3N + 1` one gets `q = g((N-1)/2) · 2N · t⁻¹ ∈ Wild` (`wild_of_cert`).
  The counting claim `|Σ_q| > q - 1` is proved from `primorial_le_four_pow` (Mathlib has no
  Rosser–Schoenfeld bounds): the non-smooth elements are primes `p ∈ (q, 6q)` and `5p` with
  `p ∈ (q, 6q/5)`, and `q^#{primes in (q, M]} ≤ M# ≤ 4^M` gives at most `0.96 q` of them.
* For `17 ≤ q < 2^15` prime to `6` (`q ∉ H`), the kernel-checked table `alCert` supplies odd
  `f₁, f₂ < q`, prime to `3`, with `q ∣ 3 f₁ f₂ + 1` (the same construction with `N = f₁ f₂`).

The induction thresholds (`128 m ≤ N`, `2^15`) differ from the paper's (`(2^k - 1)/189`,
`q ≥ 256` plus a computer check below `400`), but the theorems proved are the paper's.
-/

namespace Collatz.ALSemigroup

open Collatz Finset

/-! ## The semigroups -/

/-- The 3x+1 semigroup `S`, generated by `2` and `(2k+1)/(3k+2)` for `k ≥ 0`. -/
def S3 : Submonoid ℚ :=
  Submonoid.closure ({2} ∪ Set.range fun k : ℕ => ((2 * k + 1 : ℚ) / (3 * k + 2)))

/-- The wild semigroup `W = S⁻¹`, generated by `1/2` and `(3k+2)/(2k+1)` for `k ≥ 0`. -/
def Wild : Submonoid ℚ :=
  Submonoid.closure ({1 / 2} ∪ Set.range fun k : ℕ => ((3 * k + 2 : ℚ) / (2 * k + 1)))

/-- The generator `g(k) = (3k+2)/(2k+1)` of `Wild`. -/
def gW (k : ℕ) : ℚ := (3 * k + 2 : ℚ) / (2 * k + 1)

lemma two_mem_S3 : (2 : ℚ) ∈ S3 := Submonoid.subset_closure (Or.inl rfl)

lemma gS_mem (k : ℕ) : ((2 * k + 1 : ℚ) / (3 * k + 2)) ∈ S3 :=
  Submonoid.subset_closure (Or.inr ⟨k, rfl⟩)

lemma half_mem_S3 : (1 / 2 : ℚ) ∈ S3 := by simpa using gS_mem 0

lemma half_mem_W : (1 / 2 : ℚ) ∈ Wild := Submonoid.subset_closure (Or.inl rfl)

lemma gW_mem (k : ℕ) : gW k ∈ Wild := Submonoid.subset_closure (Or.inr ⟨k, rfl⟩)

lemma two_mem_W : (2 : ℚ) ∈ Wild := by simpa [gW] using gW_mem 0

lemma Wild_eq_map : Wild = S3.map (invMonoidHom : ℚ →* ℚ) := by
  rw [S3, MonoidHom.map_mclosure, Wild, Set.image_union, Set.image_singleton, ← Set.range_comp]
  congr 1
  ext x
  simp [Function.comp_def, inv_div]

/-- `W = S⁻¹`. -/
theorem mem_Wild_iff_inv_mem_S3 {q : ℚ} : q ∈ Wild ↔ q⁻¹ ∈ S3 := by
  rw [Wild_eq_map, Submonoid.mem_map]
  constructor
  · rintro ⟨x, hx, rfl⟩
    simpa using hx
  · intro h
    exact ⟨q⁻¹, h, by simp⟩

/-! ## The easy inclusion -/

lemma den_gS (k : ℕ) : ¬ 3 ∣ ((2 * k + 1 : ℚ) / (3 * k + 2)).den := by
  intro h
  have e : ((2 * k + 1 : ℚ) / (3 * k + 2)) = ((2 * k + 1 : ℕ) : ℚ) * ((3 * k + 2 : ℕ) : ℚ)⁻¹ := by
    push_cast
    ring
  rw [e] at h
  have h2 := dvd_trans h (Rat.mul_den_dvd _ _)
  rw [Rat.inv_natCast_den_of_pos (by omega), Rat.den_natCast, one_mul] at h2
  omega

/-- The easy direction of Theorem 1.1: elements of `S` are positive with denominator prime
to `3`. -/
theorem S3_subset {q : ℚ} (h : q ∈ S3) : 0 < q ∧ ¬ 3 ∣ q.den := by
  induction h using Submonoid.closure_induction with
  | mem x hx =>
    rcases hx with hx | ⟨k, rfl⟩
    · rw [Set.mem_singleton_iff] at hx
      subst hx
      exact ⟨by norm_num, by decide⟩
    · exact ⟨by positivity, den_gS k⟩
  | one => exact ⟨by norm_num, by decide⟩
  | mul x y _ _ hx hy =>
    refine ⟨mul_pos hx.1 hy.1, fun h3 => ?_⟩
    rcases (Nat.Prime.dvd_mul Nat.prime_three).1 (dvd_trans h3 (Rat.mul_den_dvd x y)) with h | h
    exacts [hx.2 h, hy.2 h]

lemma pos_of_mem_Wild {q : ℚ} (h : q ∈ Wild) : 0 < q :=
  inv_pos.1 (S3_subset (mem_Wild_iff_inv_mem_S3.1 h)).1

/-- If `w ∈ W` and `w x ∈ S`, then `x ∈ S`. -/
lemma mem_S3_of_mul_wild {w x : ℚ} (hw : w ∈ Wild) (h : w * x ∈ S3) : x ∈ S3 := by
  have hw0 : w ≠ 0 := (pos_of_mem_Wild hw).ne'
  have := mul_mem (mem_Wild_iff_inv_mem_S3.1 hw) h
  rwa [← mul_assoc, inv_mul_cancel₀ hw0, one_mul] at this

/-! ## The 3x+1 map and `S` -/

lemma mem_S3_of_step {n : ℕ} (h : ((step n : ℕ) : ℚ) ∈ S3) : (n : ℚ) ∈ S3 := by
  rcases Nat.even_or_odd' n with ⟨k, rfl | rfl⟩
  · rw [step_even (by omega), show 2 * k / 2 = k by omega] at h
    have e : ((2 * k : ℕ) : ℚ) = 2 * (k : ℚ) := by push_cast; ring
    rw [e]
    exact mul_mem two_mem_S3 h
  · rw [step_odd (by omega)] at h
    have h0 : (3 * (k : ℚ) + 2) ≠ 0 := by positivity
    have e : ((2 * k + 1 : ℕ) : ℚ) =
        ((2 * k + 1 : ℚ) / (3 * k + 2)) * (1 / 2) * ((3 * (2 * k + 1) + 1 : ℕ) : ℚ) := by
      push_cast
      field_simp
      ring
    rw [e]
    exact mul_mem (mul_mem (gS_mem k) half_mem_S3) h

set_option linter.unusedVariables false in
/-- Every `n` whose 3x+1 orbit reaches `1` lies in `S`: the 3x+1 conjecture implies the weak
3x+1 conjecture. -/
theorem mem_S3_of_reachesOne {n : ℕ} (hn : 1 ≤ n) (h : ReachesOne n) : (n : ℚ) ∈ S3 := by
  obtain ⟨k, hk⟩ := h
  clear hn
  induction k generalizing n with
  | zero =>
    simp only [Function.iterate_zero, id] at hk
    subst hk
    simp
  | succ k ih =>
    rw [Function.iterate_succ_apply] at hk
    exact mem_S3_of_step (ih hk)

lemma kstepT_cases (v : ℕ) :
    (v % 2 = 0 ∧ kstepT v = v / 2) ∨ (v % 2 = 1 ∧ kstepT v = (3 * v + 1) / 2) := by
  unfold kstepT
  rcases Nat.mod_two_eq_zero_or_one v with h | h <;> simp [h]

/-- `T v = s v` with `s ∈ W` (`s = 1/2` or `s = g(k)`). -/
lemma kstepT_wild {v : ℕ} (hv : 1 ≤ v) : 1 ≤ kstepT v ∧ ∃ s ∈ Wild, s * v = kstepT v := by
  rcases kstepT_cases v with ⟨h2, he⟩ | ⟨h2, he⟩
  · refine ⟨by omega, 1 / 2, half_mem_W, ?_⟩
    rw [he]
    obtain ⟨k, rfl⟩ : ∃ k, v = 2 * k := ⟨v / 2, by omega⟩
    rw [show 2 * k / 2 = k by omega]
    push_cast
    ring
  · refine ⟨by omega, gW (v / 2), gW_mem _, ?_⟩
    rw [he]
    obtain ⟨k, rfl⟩ : ∃ k, v = 2 * k + 1 := ⟨v / 2, by omega⟩
    rw [show (2 * k + 1) / 2 = k by omega, show (3 * (2 * k + 1) + 1) / 2 = 3 * k + 2 by omega]
    unfold gW
    have h0 : (2 * (k : ℚ) + 1) ≠ 0 := by positivity
    push_cast
    field_simp

/-! ## Lemma 3.1: `H ⊆ W` (Table 3) -/

/-- The set `H` of Lemma 2.1. -/
def Hset : Finset ℕ := {5, 7, 11, 13, 23, 29, 43}

lemma isH_iff (h : ℕ) : isH h = true ↔ h ∈ Hset := by
  simp [isH, Hset, or_assoc]

/-- Closes goals `product of generators ∈ Wild`. -/
macro "wild_tac" : tactic =>
  `(tactic| repeat' (first | exact gW_mem _ | exact half_mem_W | apply mul_mem | apply pow_mem))

lemma five_mem_W : (5 : ℚ) ∈ Wild := by
  rw [show (5 : ℚ) = (1 / 2) ^ 2 * (gW 3 ^ 2 * gW 5 * gW 8 * gW 27 * gW 32 * gW 41) by
    norm_num [gW]]
  wild_tac

lemma seven_mem_W : (7 : ℚ) ∈ Wild := by
  rw [show (7 : ℚ) = (1 / 2) ^ 2 *
      (gW 3 * gW 8 * gW 11 * gW 71 * gW 99 * gW 107 * gW 123 * gW 132) by norm_num [gW]]
  wild_tac

lemma eleven_mem_W : (11 : ℚ) ∈ Wild := by
  rw [show (11 : ℚ) = (1 / 2) ^ 2 *
      (gW 3 ^ 2 * gW 8 * gW 11 * gW 71 * gW 99 * gW 107 * gW 123 * gW 132) by norm_num [gW]]
  wild_tac

lemma thirteen_mem_W : (13 : ℚ) ∈ Wild := by
  rw [show (13 : ℚ) = (1 / 2) ^ 3 *
      (gW 3 ^ 2 * gW 5 * gW 8 ^ 2 * gW 11 * gW 71 * gW 99 * gW 107 * gW 123 * gW 132) by
    norm_num [gW]]
  wild_tac

lemma twentythree_mem_W : (23 : ℚ) ∈ Wild := by
  rw [show (23 : ℚ) = (1 / 2) ^ 5 *
      (gW 3 * gW 8 * gW 11 * gW 15 * gW 45 * gW 51 * gW 68 * gW 71 * gW 99 ^ 2 * gW 107 *
        gW 117 * gW 123 * gW 132 ^ 2 * gW 176) by norm_num [gW]]
  wild_tac

lemma twentynine_mem_W : (29 : ℚ) ∈ Wild := by
  rw [show (29 : ℚ) = (1 / 2) ^ 5 *
      (gW 3 ^ 4 * gW 5 ^ 2 * gW 8 ^ 2 * gW 9 * gW 12 * gW 27 ^ 2 * gW 32 ^ 2 * gW 41 ^ 2) by
    norm_num [gW]]
  wild_tac

lemma fortythree_mem_W : (43 : ℚ) ∈ Wild := by
  rw [show (43 : ℚ) = (1 / 2) ^ 11 *
      (gW 3 ^ 5 * gW 5 ^ 2 * gW 8 ^ 3 * gW 9 * gW 11 * gW 12 * gW 27 ^ 2 * gW 32 ^ 2 *
        gW 41 ^ 2 * gW 71 * gW 99 * gW 101 * gW 107 * gW 114 * gW 123 * gW 132 * gW 152) by
    norm_num [gW]]
  wild_tac

/-- **Lemma 3.1.** `H = {5, 7, 11, 13, 23, 29, 43} ⊆ W` (Table 3 of the paper). -/
theorem lemma_3_1 : ∀ h ∈ Hset, (h : ℚ) ∈ Wild := by
  intro h hh
  simp only [Hset, Finset.mem_insert, Finset.mem_singleton] at hh
  rcases hh with rfl | rfl | rfl | rfl | rfl | rfl | rfl
  · simpa using five_mem_W
  · simpa using seven_mem_W
  · simpa using eleven_mem_W
  · simpa using thirteen_mem_W
  · simpa using twentythree_mem_W
  · simpa using twentynine_mem_W
  · simpa using fortythree_mem_W

/-! ## Lemma 2.1 (Tables 1–2) -/

lemma kall_spec' {f : ℕ → Bool} : ∀ {n : ℕ}, kall f n = true → ∀ i < n, f i = true
  | 0, _, i, hi => absurd hi (Nat.not_lt_zero i)
  | n + 1, h, i, hi => by
    have e : kall f (n + 1) = (f n && kall f n) := rfl
    rw [e, Bool.and_eq_true] at h
    rcases Nat.lt_succ_iff_lt_or_eq.1 hi with hi | rfl
    · exact kall_spec' h.2 i hi
    · exact h.1

lemma kallFrom_spec' {f : ℕ → Bool} {lo len : ℕ} (h : kallFrom f lo len = true) :
    ∀ i, lo ≤ i → i < lo + len → f i = true := by
  intro i h1 h2
  have := kall_spec' h (i - lo) (by omega)
  rwa [Nat.add_sub_cancel' h1] at this

/-- One operation: `0` is a step of `T`, `o > 0` is multiplication by `o`. -/
def runOp (o v : ℕ) : ℕ := if o = 0 then kstepT v else o * v

/-- Run a list of operations. -/
def run : List ℕ → ℕ → ℕ
  | [], v => v
  | o :: os, v => run os (runOp o v)

lemma run_wild (hH : ∀ h ∈ Hset, (h : ℚ) ∈ Wild) :
    ∀ (ops : List ℕ), (∀ o ∈ ops, o = 0 ∨ isH o = true) → ∀ v, 1 ≤ v →
      1 ≤ run ops v ∧ ∃ s ∈ Wild, s * v = run ops v
  | [], _, v, hv => ⟨hv, 1, one_mem _, one_mul _⟩
  | o :: os, hops, v, hv => by
    have h1 : 1 ≤ runOp o v ∧ ∃ s ∈ Wild, s * v = runOp o v := by
      unfold runOp
      split_ifs with ho
      · exact kstepT_wild hv
      · rcases hops o (List.mem_cons_self) with h | h
        · exact absurd h ho
        · have hm := (isH_iff o).1 h
          refine ⟨Nat.one_le_iff_ne_zero.2 (Nat.mul_ne_zero ho (by omega)), o, hH o hm, ?_⟩
          push_cast
          ring
    obtain ⟨hv', s1, hs1, he1⟩ := h1
    obtain ⟨hp, s2, hs2, he2⟩ :=
      run_wild hH os (fun o' ho' => hops o' (List.mem_cons_of_mem _ ho')) _ hv'
    refine ⟨hp, s2 * s1, mul_mem hs2 hs1, ?_⟩
    change _ = (run os (runOp o v) : ℚ)
    rw [← he2, ← he1, mul_assoc]

lemma kstepT_affine {a b : ℕ} (ha : a % 2 = 0) (m : ℕ) :
    kstepT (a * m + b) =
      if b % 2 = 0 then a / 2 * m + b / 2 else 3 * a / 2 * m + (3 * b + 1) / 2 := by
  obtain ⟨a0, rfl⟩ : ∃ a0, a = 2 * a0 := ⟨a / 2, by omega⟩
  obtain ⟨X, hX⟩ : ∃ X, X = a0 * m := ⟨_, rfl⟩
  have e1 : 2 * a0 * m + b = 2 * X + b := by rw [hX]; ring
  have e2 : 2 * a0 / 2 * m = X := by rw [hX, Nat.mul_div_cancel_left _ (by norm_num)]
  have e3 : 3 * (2 * a0) / 2 * m = 3 * X := by
    rw [hX, show 3 * (2 * a0) / 2 = 3 * a0 by omega]
    ring
  rw [e1, e2, e3]
  rcases kstepT_cases (2 * X + b) with ⟨h2, he⟩ | ⟨h2, he⟩ <;> rw [he] <;> split_ifs <;> omega

lemma symCheck_spec {fin : ℕ → ℕ → Bool} :
    ∀ (ops : List ℕ) (a b : ℕ), symCheck fin ops a b = true → ∀ m,
      ∃ A B, fin A B = true ∧ run ops (a * m + b) = A * m + B
  | [], a, b, h, m => ⟨a, b, h, rfl⟩
  | o :: os, a, b, h, m => by
    simp only [symCheck] at h
    by_cases ho : o = 0
    · simp only [ho, ↓reduceIte, Bool.and_eq_true, beq_iff_eq] at h
      obtain ⟨ha, h⟩ := h
      have e : run (o :: os) (a * m + b) = run os (kstepT (a * m + b)) := by
        simp [run, runOp, ho]
      rw [e, kstepT_affine ha]
      split_ifs at h ⊢ with hb
      · exact symCheck_spec os _ _ h m
      · exact symCheck_spec os _ _ h m
    · simp only [ho, ↓reduceIte] at h
      have e : run (o :: os) (a * m + b) = run os (o * a * m + o * b) := by
        simp only [run, runOp, ho, ↓reduceIte]
        congr 1
        ring
      rw [e]
      exact symCheck_spec os _ _ h m

/-- **Lemma 2.1.** If `H ⊆ W`, then for every integer `x > 1` with `x ≢ -1 (mod 4096)` there is
`s ∈ W` with `s x ∈ ℤ` (here: `s x = z` for a natural number `z > 0`) and `s x ≤ 76/79 x`. -/
theorem lemma_2_1 (hH : ∀ h ∈ Hset, (h : ℚ) ∈ Wild) {x : ℕ} (hx : 1 < x)
    (h4 : x % 4096 ≠ 4095) :
    ∃ s ∈ Wild, ∃ z : ℕ, s * x = z ∧ 0 < z ∧ (z : ℚ) ≤ 76 / 79 * x := by
  have hc := kall_spec' alCover (x % 4096) (Nat.mod_lt _ (by norm_num))
  simp only [Bool.or_eq_true, beq_iff_eq, List.any_eq_true] at hc
  rcases hc with hc | ⟨⟨s, K, ops⟩, hrow, hr⟩
  · exact absurd hc h4
  have hok := List.all_eq_true.1 alRowsOK _ hrow
  simp only [rowOK, Bool.and_eq_true, Nat.ble_eq, Nat.blt_eq, List.all_eq_true,
    Bool.or_eq_true, beq_iff_eq] at hok
  obtain ⟨⟨⟨⟨hK1, hK12⟩, hs⟩, hops⟩, hsym⟩ := hok
  dsimp only at hr
  have hdvd : 2 ^ K ∣ 4096 := by
    have := Nat.pow_dvd_pow 2 hK12
    simpa using this
  rw [Nat.mod_mod_of_dvd x hdvd] at hr
  have hK : 0 < 2 ^ K := by positivity
  obtain ⟨m, hm⟩ : ∃ m, m = x / 2 ^ K := ⟨_, rfl⟩
  have hxm : 2 ^ K * m + s = x := by rw [hm, ← hr]; exact Nat.div_add_mod x (2 ^ K)
  obtain ⟨A, B, hfin, hrun⟩ := symCheck_spec ops (2 ^ K) s hsym m
  obtain ⟨hpos, sW, hsW, heq⟩ :=
    run_wild hH ops (fun o ho => by
      rcases hops o ho with h | h
      · exact Or.inl h
      · exact Or.inr h) x (by omega)
  refine ⟨sW, hsW, run ops x, heq, hpos, ?_⟩
  simp only [finOK, Bool.and_eq_true, Nat.ble_eq] at hfin
  obtain ⟨hA, hB⟩ := hfin
  have hmm : m0 s ≤ m := by
    unfold m0
    split_ifs with hs1
    · rcases Nat.eq_zero_or_pos m with h0 | h0
      · subst h0
        omega
      · omega
    · omega
  obtain ⟨d, hd⟩ : ∃ d, m = m0 s + d := ⟨m - m0 s, by omega⟩
  have key0 : 79 * (A * m + B) ≤ 76 * (2 ^ K * m + s) := by
    have e1 : 79 * (A * m + B) = 79 * (A * m0 s + B) + 79 * A * d := by rw [hd]; ring
    have e2 : 76 * (2 ^ K * m + s) = 76 * (2 ^ K * m0 s + s) + 76 * 2 ^ K * d := by
      rw [hd]; ring
    rw [e1, e2]
    exact Nat.add_le_add hB (Nat.mul_le_mul_right d hA)
  have key : 79 * run ops x ≤ 76 * x := by
    rw [← hxm, hrun]
    exact key0
  have : (79 : ℚ) * (run ops x : ℚ) ≤ 76 * x := by exact_mod_cast key
  linarith

/-- Lemma 2.1 in the form used below. -/
lemma lemma_2_1' {x : ℕ} (hx : 1 < x) (h4 : x % 4096 ≠ 4095) :
    ∃ z, 1 ≤ z ∧ 79 * z ≤ 76 * x ∧ ((z : ℚ) ∈ S3 → (x : ℚ) ∈ S3) := by
  obtain ⟨s, hs, z, hsz, hz0, hzle⟩ := lemma_2_1 lemma_3_1 hx h4
  refine ⟨z, hz0, ?_, fun hz => mem_S3_of_mul_wild hs (by rw [hsz]; exact hz)⟩
  have : (79 * z : ℚ) ≤ 76 * x := by linarith
  exact_mod_cast this

/-! ## Lemmas 2.2 and 2.3: the class `-1 (mod 4096)` -/

lemma two_pow_mod_nine {j : ℕ} (hj : j % 6 = 1 ∨ j % 6 = 5) : 2 ^ j % 9 = 2 ∨ 2 ^ j % 9 = 5 := by
  have e : 2 ^ j = 64 ^ (j / 6) * 2 ^ (j % 6) := by
    conv_lhs => rw [← Nat.div_add_mod j 6, pow_add, pow_mul]
    norm_num
  have h64 : 64 ^ (j / 6) % 9 = 1 := by
    rw [Nat.pow_mod]
    norm_num
  rw [e, Nat.mul_mod, h64]
  rcases hj with h | h <;> rw [h] <;> norm_num

lemma kstepT_iterate_two_pow : ∀ (i y : ℕ), kstepT^[i] (2 ^ i * y) = y
  | 0, y => by simp
  | i + 1, y => by
    rw [Function.iterate_succ_apply]
    have : kstepT (2 ^ (i + 1) * y) = 2 ^ i * y := by
      rcases kstepT_cases (2 ^ (i + 1) * y) with ⟨_, he⟩ | ⟨h2, _⟩
      · rw [he, pow_succ, mul_comm (2 ^ i) 2, mul_assoc, Nat.mul_div_cancel_left _ (by norm_num)]
      · rw [pow_succ, mul_comm (2 ^ i) 2, mul_assoc] at h2
        omega
    rw [this, kstepT_iterate_two_pow i y]

/-- **Lemma 2.2.** If `x ≡ -1 (mod 2^k)`, `j ≤ k` and `j ≡ 1, 5 (mod 6)`, then
`T^j(((2^j + 1)/3) x) = x + (x + 1)/2^j`. -/
theorem lemma_2_2 {x k j : ℕ} (hx : (x + 1) % 2 ^ k = 0) (hjk : j ≤ k)
    (hj : j % 6 = 1 ∨ j % 6 = 5) :
    kstepT^[j] ((2 ^ j + 1) / 3 * x) = x + (x + 1) / 2 ^ j := by
  have h9 := two_pow_mod_nine hj
  obtain ⟨w, hw⟩ : ∃ w, w = (2 ^ j + 1) / 3 := ⟨_, rfl⟩
  have hw3 : 3 * w = 2 ^ j + 1 := by omega
  rw [← hw]
  obtain ⟨c, hc⟩ : 2 ^ k ∣ x + 1 := Nat.dvd_of_mod_eq_zero hx
  have hpow : 2 ^ k = 2 ^ j * 2 ^ (k - j) := by rw [← pow_add, Nat.add_sub_cancel' hjk]
  have hd : (x + 1) / 2 ^ j = 2 ^ (k - j) * c := by
    rw [hc, hpow, mul_assoc, Nat.mul_div_cancel_left _ (by positivity)]
  rw [hd]
  have hj1 : 1 ≤ j := by omega
  obtain ⟨i, rfl⟩ : ∃ i, j = i + 1 := ⟨j - 1, by omega⟩
  have hy : 3 * (w * x) + 1 = 2 * (2 ^ i * (x + 2 ^ (k - (i + 1)) * c)) := by
    calc 3 * (w * x) + 1 = (3 * w) * x + 1 := by ring
      _ = 2 ^ (i + 1) * x + (x + 1) := by rw [hw3]; ring
      _ = 2 ^ (i + 1) * x + 2 ^ (i + 1) * 2 ^ (k - (i + 1)) * c := by rw [hc, hpow, mul_assoc]
      _ = 2 * (2 ^ i * (x + 2 ^ (k - (i + 1)) * c)) := by rw [pow_succ]; ring
  rw [Function.iterate_succ_apply]
  have : kstepT (w * x) = 2 ^ i * (x + 2 ^ (k - (i + 1)) * c) := by
    rcases kstepT_cases (w * x) with ⟨h2, _⟩ | ⟨_, he⟩
    · omega
    · rw [he]
      omega
  rw [this, kstepT_iterate_two_pow]

/-- Lemma 2.2, multiplicatively: if `3w = 2^j + 1`, `3 w x + 1 = 2^j y`, `w ∈ W` and `y ∈ S`,
then `x ∈ S`. -/
lemma lemma_2_2_S3 {x y j w : ℕ} (hj : 1 ≤ j) (hy : 3 * (w * x) + 1 = 2 ^ j * y)
    (hW : (w : ℚ) ∈ Wild) (hyS : (y : ℚ) ∈ S3) : (x : ℚ) ∈ S3 := by
  obtain ⟨i, rfl⟩ : ∃ i, j = i + 1 := ⟨j - 1, by omega⟩
  obtain ⟨Q, hQ⟩ : ∃ Q, Q = 2 ^ i * y := ⟨_, rfl⟩
  have hy' : 3 * (w * x) + 1 = 2 * Q := by rw [hy, hQ, pow_succ]; ring
  obtain ⟨n, hn⟩ : ∃ n, n = w * x := ⟨_, rfl⟩
  rw [← hn] at hy'
  obtain ⟨l, hl⟩ : ∃ l, n = 2 * l + 1 := ⟨n / 2, by omega⟩
  have hQl : 3 * l + 2 = Q := by omega
  have hnS : (n : ℚ) ∈ S3 := by
    have e : (n : ℚ) = ((2 * l + 1 : ℚ) / (3 * l + 2)) * (2 ^ i * y) := by
      have h0 : (3 * (l : ℚ) + 2) ≠ 0 := by positivity
      have : (3 * (l : ℚ) + 2) = 2 ^ i * y := by exact_mod_cast (hQl.trans hQ)
      rw [← this, hl]
      push_cast
      field_simp
    rw [e]
    exact mul_mem (gS_mem l) (mul_mem (pow_mem two_mem_S3 _) hyS)
  apply mem_S3_of_mul_wild hW
  rw [← Nat.cast_mul, ← hn]
  exact hnS

lemma not_dvd_4096 {a o : ℕ} (ha : a ≤ 11) (ho : o % 2 = 1) : ¬ 4096 ∣ 2 ^ a * o := by
  intro h
  have e : (4096 : ℕ) = 2 ^ a * 2 ^ (12 - a) := by
    rw [← pow_add, Nat.add_sub_cancel' (by omega)]
    norm_num
  rw [e] at h
  have h2 := Nat.dvd_of_mul_dvd_mul_left (by positivity) h
  have : 2 ∣ o := dvd_trans (dvd_pow_self 2 (by omega : 12 - a ≠ 0)) h2
  omega

/-- **Lemma 2.3** (modified form). If `x ≡ -1 (mod 4096)` and every `m ≥ 1` with `3 ∤ m` and
`128 m < x` is wild, then there is `1 ≤ z < x` with `z ∈ S → x ∈ S`.

(The paper's Lemma 2.3 instead assumes the decrease property `s x ≤ 1235/1264 x` for the classes
`≢ -1 (mod 2^k)` and extends it to `2^{k+1}`, using the wild numbers `(2^j + 1)/3`.) -/
theorem lemma_2_3 {x : ℕ} (hx : x % 4096 = 4095)
    (hW : ∀ m, 1 ≤ m → ¬ 3 ∣ m → 128 * m < x → (m : ℚ) ∈ Wild) :
    ∃ z, 1 ≤ z ∧ z < x ∧ ((z : ℚ) ∈ S3 → (x : ℚ) ∈ S3) := by
  obtain ⟨k, c, hc, hxk⟩ := Nat.exists_eq_two_pow_mul_odd (n := x + 1) (by omega)
  have hc2 : c % 2 = 1 := Nat.odd_iff.1 hc
  have hk : 12 ≤ k := by
    by_contra hk
    exact not_dvd_4096 (by omega) hc2 (hxk ▸ (by omega : 4096 ∣ x + 1))
  obtain ⟨j, hj7, hjk, hkj, hj6, hjw⟩ : ∃ j, 7 ≤ j ∧ j ≤ k ∧ k ≤ j + 11 ∧
      (j % 6 = 1 ∨ j % 6 = 5) ∧ (j = 7 ∨ j + 8 ≤ k) := by
    by_cases hk18 : k ≤ 18
    · exact ⟨7, by omega, by omega, by omega, by omega, Or.inl rfl⟩
    · have : (k - 11) % 6 = 0 ∨ (k - 11) % 6 = 1 ∨ (k - 11) % 6 = 2 ∨ (k - 11) % 6 = 3 ∨
          (k - 11) % 6 = 4 ∨ (k - 11) % 6 = 5 := by omega
      rcases this with h | h | h | h | h | h
      · exact ⟨k - 11 + 1, by omega, by omega, by omega, by omega, Or.inr (by omega)⟩
      · exact ⟨k - 11, by omega, by omega, by omega, by omega, Or.inr (by omega)⟩
      · exact ⟨k - 11 + 3, by omega, by omega, by omega, by omega, Or.inr (by omega)⟩
      · exact ⟨k - 11 + 2, by omega, by omega, by omega, by omega, Or.inr (by omega)⟩
      · exact ⟨k - 11 + 1, by omega, by omega, by omega, by omega, Or.inr (by omega)⟩
      · exact ⟨k - 11, by omega, by omega, by omega, by omega, Or.inr (by omega)⟩
  have h9 := two_pow_mod_nine hj6
  obtain ⟨w, hw⟩ : ∃ w, w = (2 ^ j + 1) / 3 := ⟨_, rfl⟩
  have hw3 : 3 * w = 2 ^ j + 1 := by omega
  have hw3' : ¬ 3 ∣ w := by omega
  have h2k : 2 ^ k ≤ x + 1 := by
    rw [hxk]
    exact Nat.le_mul_of_pos_right _ (by omega)
  have hwW : (w : ℚ) ∈ Wild := by
    rcases hjw with rfl | hjw
    · have : w = 43 := by norm_num at hw; exact hw
      rw [this]
      exact lemma_3_1 43 (by simp [Hset])
    · have h1 : 2 ^ j * 256 ≤ 2 ^ k := by
        calc 2 ^ j * 256 = 2 ^ (j + 8) := by rw [pow_add]; norm_num
          _ ≤ 2 ^ k := Nat.pow_le_pow_right (by norm_num) hjw
      exact hW w (by omega) hw3' (by omega)
  have hpow : 2 ^ k = 2 ^ j * 2 ^ (k - j) := by rw [← pow_add, Nat.add_sub_cancel' hjk]
  obtain ⟨d, hd⟩ : ∃ d, d = 2 ^ (k - j) * c := ⟨_, rfl⟩
  have hdx : 2 ^ j * d = x + 1 := by rw [hd, hxk, hpow, mul_assoc]
  have hy : 3 * (w * (x)) + 1 = 2 ^ j * (x + d) := by
    calc 3 * (w * x) + 1 = (3 * w) * x + 1 := by ring
      _ = 2 ^ j * x + (x + 1) := by rw [hw3]; ring
      _ = 2 ^ j * (x + d) := by rw [← hdx]; ring
  have hy1 : x + d + 1 = 2 ^ (k - j) * (c * (2 ^ j + 1)) := by
    rw [show x + d + 1 = (x + 1) + d by ring, ← hdx, hd]
    ring
  have hodd : (c * (2 ^ j + 1)) % 2 = 1 := by
    have h2j : 2 ∣ 2 ^ j := dvd_pow_self 2 (by omega)
    have : 2 ^ j % 2 = 0 := by omega
    rw [Nat.mul_mod, hc2, Nat.add_mod, this]
  have hy4 : (x + d) % 4096 ≠ 4095 := by
    intro h
    exact not_dvd_4096 (by omega) hodd (hy1 ▸ (by omega : 4096 ∣ x + d + 1))
  obtain ⟨z, hz1, hz79, himp⟩ := lemma_2_1' (by omega : 1 < x + d) hy4
  have h128 : 128 ≤ 2 ^ j := by
    calc (128 : ℕ) = 2 ^ 7 := by norm_num
      _ ≤ 2 ^ j := Nat.pow_le_pow_right (by norm_num) hj7
  have hd128 : 128 * d ≤ x + 1 := by
    rw [← hdx]
    exact Nat.mul_le_mul_right d h128
  refine ⟨z, hz1, by omega, fun hz => ?_⟩
  exact lemma_2_2_S3 (by omega) hy hwW (himp hz)

/-! ## Wild numbers -/

lemma wild_of_cert {q N t : ℕ} (hN : N % 2 = 1) (hNw : (N : ℚ) ∈ Wild) (ht : q * t = 3 * N + 1)
    (htS : (t : ℚ) ∈ S3) : (q : ℚ) ∈ Wild := by
  obtain ⟨l, hl⟩ : ∃ l, N = 2 * l + 1 := ⟨N / 2, by omega⟩
  have ht0 : (t : ℚ) ≠ 0 := by
    have : t ≠ 0 := by rintro rfl; omega
    exact_mod_cast this
  have hqt : (q : ℚ) * t = 2 * (3 * l + 2) := by
    have : q * t = 2 * (3 * l + 2) := by omega
    exact_mod_cast this
  have e : (q : ℚ) = gW l * 2 * N * (t : ℚ)⁻¹ := by
    have h0 : (2 * (l : ℚ) + 1) ≠ 0 := by positivity
    unfold gW
    rw [hl]
    push_cast
    field_simp
    linarith
  rw [e]
  refine mul_mem (mul_mem (mul_mem (gW_mem l) two_mem_W) hNw) ?_
  rw [mem_Wild_iff_inv_mem_S3, inv_inv]
  exact htS

lemma wild_of_factors : ∀ s : ℕ, s ≠ 0 → (∀ p, p.Prime → p ∣ s → (p : ℚ) ∈ Wild) →
    (s : ℚ) ∈ Wild := by
  intro s
  induction s using Nat.strong_induction_on with
  | _ s ih =>
    intro hs h
    by_cases h1 : s = 1
    · subst h1
      simp
    have hp : s.minFac.Prime := Nat.minFac_prime h1
    have hdvd := Nat.minFac_dvd s
    have hlt : s / s.minFac < s := Nat.div_lt_self (by omega) hp.one_lt
    have hpos : s / s.minFac ≠ 0 :=
      (Nat.div_pos (Nat.minFac_le (by omega)) hp.pos).ne'
    have e : s = s.minFac * (s / s.minFac) := (Nat.mul_div_cancel' hdvd).symm
    rw [e, Nat.cast_mul]
    refine mul_mem (h _ hp hdvd) (ih _ hlt hpos fun p hp' hpd => h p hp' ?_)
    exact dvd_trans hpd (Nat.div_dvd_of_dvd hdvd)

/-! ### Lemma 3.2: large primes -/

lemma exists_r {q : ℕ} (hq : q.Prime) (h5 : 5 ≤ q) :
    ∃ r, r < 6 * q ∧ Nat.Coprime r (6 * q) ∧ q ∣ 3 * r + 1 := by
  have h3 : q % 3 ≠ 0 := by
    intro h
    have := (Nat.prime_dvd_prime_iff_eq Nat.prime_three hq).1 (by omega)
    omega
  obtain ⟨a, ha9, haq⟩ : ∃ a, a ≤ 8 ∧ (a * q) % 9 = 8 := by
    have : q % 9 = 1 ∨ q % 9 = 2 ∨ q % 9 = 4 ∨ q % 9 = 5 ∨ q % 9 = 7 ∨ q % 9 = 8 := by omega
    rcases this with h | h | h | h | h | h
    · exact ⟨8, by omega, by omega⟩
    · exact ⟨4, by omega, by omega⟩
    · exact ⟨2, by omega, by omega⟩
    · exact ⟨7, by omega, by omega⟩
    · exact ⟨5, by omega, by omega⟩
    · exact ⟨1, by omega, by omega⟩
  obtain ⟨P, hP⟩ : ∃ P, P = a * q := ⟨_, rfl⟩
  have hP8 : P ≤ 8 * q := by rw [hP]; exact Nat.mul_le_mul_right q ha9
  rw [← hP] at haq
  obtain ⟨r, hr⟩ : ∃ r, r = (2 * P - 1) / 3 := ⟨_, rfl⟩
  have hr3 : 3 * r + 1 = 2 * P := by omega
  have hqr : q ∣ 3 * r + 1 := by
    rw [hr3, hP]
    exact Dvd.intro_left (2 * a) (by ring)
  refine ⟨r, by omega, ?_, hqr⟩
  have c2 : Nat.Coprime r 2 :=
    Nat.coprime_comm.1 ((Nat.Prime.coprime_iff_not_dvd Nat.prime_two).2 (by omega))
  have c3 : Nat.Coprime r 3 :=
    Nat.coprime_comm.1 ((Nat.Prime.coprime_iff_not_dvd Nat.prime_three).2 (by omega))
  have cq : Nat.Coprime r q := by
    refine Nat.coprime_comm.1 ((Nat.Prime.coprime_iff_not_dvd hq).2 fun hd => ?_)
    have := (Nat.dvd_add_right (dvd_mul_of_dvd_right hd 3)).1 hqr
    exact hq.one_lt.ne' (Nat.dvd_one.1 this)
  exact Nat.Coprime.mul_right (Nat.Coprime.mul_right c2 c3) cq

/-- `q^#{primes p ∈ (q, M]} ≤ M# ≤ 4^M`, so for `q ≥ 2^15` there are at most `2M/15` such
primes. -/
lemma card_primes_le (M q : ℕ) (hq : 2 ^ 15 ≤ q) :
    15 * ((range (M + 1)).filter (fun p => p.Prime ∧ q < p)).card ≤ 2 * M := by
  set P := (range (M + 1)).filter (fun p => p.Prime ∧ q < p)
  have h1 : (2 ^ 15) ^ P.card ≤ ∏ p ∈ P, p :=
    Finset.pow_card_le_prod P id (2 ^ 15) (fun p hp => by
      simp only [P, Finset.mem_filter] at hp
      simp only [id]
      omega)
  have h2 : ∏ p ∈ P, p ≤ primorial M := by
    unfold primorial
    apply Finset.prod_le_prod_of_subset_of_one_le
    · intro p hp
      simp only [P, Finset.mem_filter] at hp ⊢
      exact ⟨hp.1, hp.2.1⟩
    · intro p hp _
      simp only [Finset.mem_filter] at hp
      exact hp.2.one_lt.le
  have h3 := primorial_le_four_pow M
  have : 2 ^ (15 * P.card) ≤ 2 ^ (2 * M) := by
    rw [pow_mul, pow_mul]
    norm_num at h1 h3 ⊢
    omega
  exact (Nat.pow_le_pow_iff_right (by norm_num)).1 this

/-- The set `Σ_q` of `q`-smooth `s < 6q` prime to `6q`. -/
noncomputable def smoothSet (q : ℕ) : Finset ℕ := by
  classical
  exact (range (6 * q)).filter (fun s => Nat.Coprime (6 * q) s ∧ ∀ p, p.Prime → p ∣ s → p < q)

lemma mem_smoothSet {q s : ℕ} : s ∈ smoothSet q ↔
    s < 6 * q ∧ Nat.Coprime (6 * q) s ∧ ∀ p, p.Prime → p ∣ s → p < q := by
  classical
  unfold smoothSet
  simp [Finset.mem_filter]

lemma not_dvd_of_coprime {n s d : ℕ} (h : Nat.Coprime n s) (hd : d ∣ n) (hd1 : 1 < d) :
    ¬ d ∣ s := by
  intro hs
  have := Nat.dvd_gcd hd hs
  rw [h] at this
  exact absurd (Nat.le_of_dvd one_pos this) (by omega)

/-- **The claim of Lemma 3.2**, for `q ≥ 2^15`: `|Σ_q| > q - 1`. -/
lemma card_smoothSet {q : ℕ} (hq : q.Prime) (hq15 : 2 ^ 15 ≤ q) : q - 1 < (smoothSet q).card := by
  set U := (range (6 * q)).filter (fun s => Nat.Coprime (6 * q) s)
  set P1 := (range (6 * q + 1)).filter (fun p => p.Prime ∧ q < p)
  set P2 := (range (6 * q / 5 + 1)).filter (fun p => p.Prime ∧ q < p)
  have hU : U.card = 2 * (q - 1) := by
    have : U.card = Nat.totient (6 * q) := rfl
    rw [this, Nat.totient_mul, Nat.totient_prime hq]
    · rfl
    · exact Nat.coprime_comm.1 ((Nat.Prime.coprime_iff_not_dvd hq).2 fun h =>
        absurd (Nat.le_of_dvd (by norm_num) h) (by omega))
  have hsub : U \ (P1 ∪ P2.image (5 * ·)) ⊆ smoothSet q := by
    intro s hs
    simp only [U, P1, P2, Finset.mem_sdiff, Finset.mem_filter, Finset.mem_range,
      Finset.mem_union, Finset.mem_image] at hs
    obtain ⟨⟨hs6, hcop⟩, hbad⟩ := hs
    refine mem_smoothSet.2 ⟨hs6, hcop, fun p hp hps => ?_⟩
    by_contra hpq'
    have hpq : q ≤ p := by omega
    have hpq' : q ≠ p := by
      rintro rfl
      exact not_dvd_of_coprime hcop (dvd_mul_left q 6) hq.one_lt hps
    obtain ⟨m, rfl⟩ := hps
    have hm0 : m ≠ 0 := by
      rintro rfl
      rw [mul_zero, Nat.coprime_zero_right] at hcop
      omega
    have hm6 : m < 6 := by
      by_contra hm'
      have hm : 6 ≤ m := by omega
      have : p * 6 ≤ p * m := Nat.mul_le_mul_left p hm
      omega
    have h2 : ¬ 2 ∣ m := fun h =>
      not_dvd_of_coprime hcop (dvd_mul_of_dvd_left (by norm_num) q) (by norm_num)
        (dvd_mul_of_dvd_right h p)
    have h3 : ¬ 3 ∣ m := fun h =>
      not_dvd_of_coprime hcop (dvd_mul_of_dvd_left (by norm_num) q) (by norm_num)
        (dvd_mul_of_dvd_right h p)
    interval_cases m
    · omega
    · exact hbad (Or.inl ⟨by omega, by simpa using hp, by omega⟩)
    · omega
    · omega
    · omega
    · exact hbad (Or.inr ⟨p, ⟨by omega, hp, by omega⟩, by ring⟩)
  have hc1 : 15 * P1.card ≤ 2 * (6 * q) := card_primes_le (6 * q) q hq15
  have hc2 : 15 * P2.card ≤ 2 * (6 * q / 5) := card_primes_le (6 * q / 5) q hq15
  have hbad : (P1 ∪ P2.image (5 * ·)).card ≤ P1.card + P2.card :=
    (Finset.card_union_le _ _).trans (Nat.add_le_add_left Finset.card_image_le _)
  have h1 := Finset.le_card_sdiff (P1 ∪ P2.image (5 * ·)) U
  have h2 := Finset.card_le_card hsub
  omega

/-- Pigeonhole in `(ZMod n)ˣ`: if `A` contains more than half of the units, then every unit
`r` is a product `s₁ s₂` with `s₁, s₂ ∈ A`. -/
lemma pigeonhole (n : ℕ) [NeZero n] (A : Finset ℕ) (hA : ∀ s ∈ A, s < n ∧ Nat.Coprime s n)
    (hcard : Nat.totient n < 2 * A.card) (r : ℕ) (hr : Nat.Coprime r n) :
    ∃ s1 ∈ A, ∃ s2 ∈ A, s1 * s2 ≡ r [MOD n] := by
  classical
  let u : ℕ → (ZMod n)ˣ := fun s => if h : Nat.Coprime s n then ZMod.unitOfCoprime s h else 1
  have hu : ∀ s ∈ A, ((u s : (ZMod n)ˣ) : ZMod n) = s := fun s hs => by
    simp only [u]
    split_ifs with h
    · exact ZMod.coe_unitOfCoprime _ _
    · exact absurd (hA s hs).2 h
  have hinj : Set.InjOn u A := by
    intro s hs t ht h
    have := congrArg (fun v : (ZMod n)ˣ => (v : ZMod n)) h
    simp only [hu s hs, hu t ht] at this
    rw [ZMod.natCast_eq_natCast_iff'] at this
    rwa [Nat.mod_eq_of_lt (hA s hs).1, Nat.mod_eq_of_lt (hA t ht).1] at this
  set R := ZMod.unitOfCoprime r hr
  set A' := A.image u
  set B' := A'.image (fun v => R * v⁻¹)
  have hA' : A'.card = A.card := Finset.card_image_of_injOn hinj
  have hB' : B'.card = A'.card :=
    Finset.card_image_of_injective _ (fun v w h => by simpa using h)
  have hnd : ¬ Disjoint A' B' := by
    intro hd
    have h1 := Finset.card_union_of_disjoint hd
    have h2 := Finset.card_le_univ (A' ∪ B')
    rw [ZMod.card_units_eq_totient] at h2
    omega
  obtain ⟨v, hv1, hv2⟩ := Finset.not_disjoint_iff.1 hnd
  obtain ⟨s2, hs2, rfl⟩ := Finset.mem_image.1 hv1
  obtain ⟨v1, hv1', hv1e⟩ := Finset.mem_image.1 hv2
  obtain ⟨s1, hs1, rfl⟩ := Finset.mem_image.1 hv1'
  refine ⟨s1, hs1, s2, hs2, ?_⟩
  have h : u s1 * u s2 = R := by
    rw [← hv1e, mul_comm R, mul_inv_cancel_left]
  have := congrArg (fun v : (ZMod n)ˣ => (v : ZMod n)) h
  simp only [Units.val_mul, hu s1 hs1, hu s2 hs2, R, ZMod.coe_unitOfCoprime] at this
  rw [← Nat.cast_mul, ZMod.natCast_eq_natCast_iff] at this
  exact this

/-- **Lemma 3.2** (modified form). A prime `q ≥ 2^15` is wild if every prime `5 ≤ p < q` is
wild and every `1 ≤ n ≤ 128 q` lies in `S`.

(The paper states this for the range `(2^j - 1)/189 < q ≤ (2^{j+1} - 1)/189`, assuming the weak
conjecture up to `2^j - 2`; its claim `|Σ_q| > q - 1` is used for `q ≥ 256`.) -/
theorem lemma_3_2 {q : ℕ} (hq : q.Prime) (hq15 : 2 ^ 15 ≤ q)
    (hW : ∀ p, p.Prime → 5 ≤ p → p < q → (p : ℚ) ∈ Wild)
    (hS : ∀ n, 1 ≤ n → n ≤ 128 * q → (n : ℚ) ∈ S3) : (q : ℚ) ∈ Wild := by
  have : NeZero (6 * q) := ⟨by omega⟩
  obtain ⟨r, -, hrc, hrq⟩ := exists_r hq (by omega)
  have hA : ∀ s ∈ smoothSet q, s < 6 * q ∧ Nat.Coprime s (6 * q) := fun s hs => by
    obtain ⟨h1, h2, -⟩ := mem_smoothSet.1 hs
    exact ⟨h1, Nat.coprime_comm.1 h2⟩
  have hcard : Nat.totient (6 * q) < 2 * (smoothSet q).card := by
    have := card_smoothSet hq hq15
    rw [Nat.totient_mul, Nat.totient_prime hq, show Nat.totient 6 = 2 from rfl]
    · omega
    · exact Nat.coprime_comm.1 ((Nat.Prime.coprime_iff_not_dvd hq).2 fun h =>
        absurd (Nat.le_of_dvd (by norm_num) h) (by omega))
  obtain ⟨s1, hs1, s2, hs2, hmod⟩ := pigeonhole (6 * q) _ hA hcard r hrc
  have hmodq : s1 * s2 ≡ r [MOD q] := Nat.ModEq.of_mul_left 6 hmod
  have hdiv : q ∣ 3 * (s1 * s2) + 1 := by
    have h1 : 3 * (s1 * s2) + 1 ≡ 3 * r + 1 [MOD q] := Nat.ModEq.add_right 1 (hmodq.mul_left 3)
    exact (Nat.modEq_zero_iff_dvd).1 (h1.trans ((Nat.modEq_zero_iff_dvd).2 hrq))
  -- the factors are odd, prime to `3`, and wild
  have hfac : ∀ s ∈ smoothSet q, s % 2 = 1 ∧ (s : ℚ) ∈ Wild := by
    intro s hs
    obtain ⟨_, hcop, hsm⟩ := mem_smoothSet.1 hs
    have n2 : ¬ 2 ∣ s := not_dvd_of_coprime hcop (dvd_mul_of_dvd_left (by norm_num) q) (by norm_num)
    have n3 : ¬ 3 ∣ s := not_dvd_of_coprime hcop (dvd_mul_of_dvd_left (by norm_num) q) (by norm_num)
    refine ⟨by omega, wild_of_factors s (by omega) fun p hp hps => hW p hp ?_ (hsm p hp hps)⟩
    have := hp.two_le
    by_contra h5
    interval_cases p
    · exact n2 hps
    · exact n3 hps
    · norm_num at hp
  obtain ⟨h1o, h1w⟩ := hfac s1 hs1
  obtain ⟨h2o, h2w⟩ := hfac s2 hs2
  have hNo : (s1 * s2) % 2 = 1 := by rw [Nat.mul_mod, h1o, h2o]
  have hNw : ((s1 * s2 : ℕ) : ℚ) ∈ Wild := by rw [Nat.cast_mul]; exact mul_mem h1w h2w
  have ht := Nat.mul_div_cancel' hdiv
  have hlt1 := (mem_smoothSet.1 hs1).1
  have hlt2 := (mem_smoothSet.1 hs2).1
  have hprod : s1 * s2 < (6 * q) * (6 * q) := Nat.mul_lt_mul'' hlt1 hlt2
  set t := (3 * (s1 * s2) + 1) / q
  have ht1 : 1 ≤ t := by
    rcases Nat.eq_zero_or_pos t with h | h
    · rw [h, mul_zero] at ht
      omega
    · exact h
  have ht128 : t ≤ 128 * q := by
    have : q * t < q * (128 * q) := by nlinarith
    exact (Nat.lt_of_mul_lt_mul_left this).le
  exact wild_of_cert hNo hNw ht (hS t ht1 ht128)

/-! ### Small `q`: the certificate table -/

lemma qOK_all {q : ℕ} (hq : q < 2 ^ 15) : qOK q = true := by
  have h0 := kallFrom_spec' qOK_0
  have h1 := kallFrom_spec' qOK_1
  have h2 := kallFrom_spec' qOK_2
  have h3 := kallFrom_spec' qOK_3
  have h4 := kallFrom_spec' qOK_4
  have h5 := kallFrom_spec' qOK_5
  have h6 := kallFrom_spec' qOK_6
  have h7 := kallFrom_spec' qOK_7
  have : q < 4096 ∨ (4096 ≤ q ∧ q < 8192) ∨ (8192 ≤ q ∧ q < 12288) ∨ (12288 ≤ q ∧ q < 16384) ∨
      (16384 ≤ q ∧ q < 20480) ∨ (20480 ≤ q ∧ q < 24576) ∨ (24576 ≤ q ∧ q < 28672) ∨
      (28672 ≤ q ∧ q < 32768) := by omega
  rcases this with h | h | h | h | h | h | h | h
  · exact h0 q (by omega) (by omega)
  · exact h1 q h.1 (by omega)
  · exact h2 q h.1 (by omega)
  · exact h3 q h.1 (by omega)
  · exact h4 q h.1 (by omega)
  · exact h5 q h.1 (by omega)
  · exact h6 q h.1 (by omega)
  · exact h7 q h.1 (by omega)

lemma wild_small {q : ℕ} (hq : q < 2 ^ 15) (h17 : 17 ≤ q) (h2 : q % 2 = 1) (h3 : q % 3 ≠ 0)
    (hH : q ≠ 23 ∧ q ≠ 29 ∧ q ≠ 43)
    (hW : ∀ m, 1 ≤ m → ¬ 3 ∣ m → m < q → (m : ℚ) ∈ Wild)
    (hS : ∀ n, 1 ≤ n → n ≤ 128 * q → (n : ℚ) ∈ S3) : (q : ℚ) ∈ Wild := by
  have hq' := qOK_all hq
  have hc : certOK q (alEnt (q / 3) % 128) (alEnt (q / 3) / 128) = true := by
    unfold qOK at hq'
    cases h : certOK q (alEnt (q / 3) % 128) (alEnt (q / 3) / 128)
    · rw [h] at hq'
      simp only [Bool.or_false, Bool.or_eq_true, beq_iff_eq, Nat.blt_eq] at hq'
      omega
    · rfl
  generalize alEnt (q / 3) % 128 = f1 at hc
  generalize alEnt (q / 3) / 128 = f2 at hc
  simp only [certOK, Bool.and_eq_true, Nat.blt_eq, beq_iff_eq, bne_iff_ne, ne_eq] at hc
  obtain ⟨⟨⟨⟨⟨⟨hf1, hf2⟩, ho1⟩, ho2⟩, ht1⟩, ht2⟩, hdiv⟩ := hc
  have hw1 := hW f1 (by omega) (by omega) hf1
  have hw2 := hW f2 (by omega) (by omega) hf2
  have hNo : (f1 * f2) % 2 = 1 := by rw [Nat.mul_mod, ho1, ho2]
  have hNw : ((f1 * f2 : ℕ) : ℚ) ∈ Wild := by rw [Nat.cast_mul]; exact mul_mem hw1 hw2
  have ht := Nat.mul_div_cancel' (Nat.dvd_of_mod_eq_zero hdiv)
  set t := (3 * (f1 * f2) + 1) / q
  have hprod : f1 * f2 < q * q := Nat.mul_lt_mul'' hf1 hf2
  have htp : 1 ≤ t := by
    rcases Nat.eq_zero_or_pos t with h | h
    · rw [h, mul_zero] at ht
      omega
    · exact h
  have ht128 : t ≤ 128 * q := by
    have : q * t < q * (128 * q) := by nlinarith
    exact (Nat.lt_of_mul_lt_mul_left this).le
  exact wild_of_cert hNo hNw ht (hS t htp ht128)

/-! ## The induction -/

lemma weak_step {x : ℕ} (hx : 1 ≤ x) (hS : ∀ n, 1 ≤ n → n < x → (n : ℚ) ∈ S3)
    (hW : ∀ m, 1 ≤ m → ¬ 3 ∣ m → 128 * m < x → (m : ℚ) ∈ Wild) : (x : ℚ) ∈ S3 := by
  rcases Nat.lt_or_ge x 2 with h1 | h2
  · have : x = 1 := by omega
    subst this
    simp
  by_cases h4 : x % 4096 = 4095
  · obtain ⟨z, hz1, hzx, himp⟩ := lemma_2_3 h4 hW
    exact himp (hS z hz1 hzx)
  · obtain ⟨z, hz1, hz79, himp⟩ := lemma_2_1' (by omega) h4
    exact himp (hS z hz1 (by omega))

lemma wild_step {m : ℕ} (h1 : 1 ≤ m) (h3 : ¬ 3 ∣ m)
    (hS : ∀ n, 1 ≤ n → n ≤ 128 * m → (n : ℚ) ∈ S3)
    (hW : ∀ m', 1 ≤ m' → ¬ 3 ∣ m' → m' < m → (m' : ℚ) ∈ Wild) : (m : ℚ) ∈ Wild := by
  by_cases hm1 : m = 1
  · subst hm1
    simp
  by_cases hp : m.Prime
  · rcases hp.eq_two_or_odd with h2 | h2
    · subst h2
      simpa using two_mem_W
    by_cases hH : m ∈ Hset
    · exact lemma_3_1 m hH
    have hH' : m ≠ 5 ∧ m ≠ 7 ∧ m ≠ 11 ∧ m ≠ 13 ∧ m ≠ 23 ∧ m ≠ 29 ∧ m ≠ 43 := by
      simp only [Hset, Finset.mem_insert, Finset.mem_singleton] at hH
      omega
    by_cases hsmall : m < 2 ^ 15
    · exact wild_small hsmall (by omega) h2 (by omega) (by omega) hW hS
    · refine lemma_3_2 hp (by omega) (fun p hp' h5 hpm => hW p (by omega) ?_ hpm) hS
      intro h3p
      have := (Nat.prime_dvd_prime_iff_eq Nat.prime_three hp').1 h3p
      omega
  · have h2 : 2 ≤ m := by omega
    have hlt := (Nat.not_prime_iff_minFac_lt h2).1 hp
    have hpr : m.minFac.Prime := Nat.minFac_prime hm1
    have hdvd := Nat.minFac_dvd m
    have hlt2 : m / m.minFac < m := Nat.div_lt_self (by omega) hpr.one_lt
    have hpos : 0 < m / m.minFac := Nat.div_pos (Nat.minFac_le (by omega)) hpr.pos
    have e : m = m.minFac * (m / m.minFac) := (Nat.mul_div_cancel' hdvd).symm
    rw [e, Nat.cast_mul]
    refine mul_mem (hW _ hpr.one_lt.le (fun h => h3 (dvd_trans h hdvd)) hlt)
      (hW _ hpos (fun h => h3 (dvd_trans h (Nat.div_dvd_of_dvd hdvd))) hlt2)

/-- The simultaneous induction: every `1 ≤ n ≤ N` lies in `S`, and every `m ≥ 1` with
`3 ∤ m` and `128 m ≤ N` lies in `W`. -/
theorem main (N : ℕ) : (∀ n, 1 ≤ n → n ≤ N → (n : ℚ) ∈ S3) ∧
    (∀ m, 1 ≤ m → ¬ 3 ∣ m → 128 * m ≤ N → (m : ℚ) ∈ Wild) := by
  induction N with
  | zero => exact ⟨fun n h1 h2 => by omega, fun m h1 _ h2 => by omega⟩
  | succ N ih =>
    obtain ⟨ihS, ihW⟩ := ih
    have hS : ∀ n, 1 ≤ n → n ≤ N + 1 → (n : ℚ) ∈ S3 := by
      intro n h1 h2
      rcases Nat.lt_or_ge n (N + 1) with h | h
      · exact ihS n h1 (by omega)
      · have : n = N + 1 := by omega
        subst this
        exact weak_step h1 (fun k hk1 hk2 => ihS k hk1 (by omega))
          (fun m hm1 hm3 hm => ihW m hm1 hm3 (by omega))
    refine ⟨hS, fun m h1 h3 h128 => ?_⟩
    rcases Nat.lt_or_ge (128 * m) (N + 1) with h | h
    · exact ihW m h1 h3 (by omega)
    · exact wild_step h1 h3 (fun n hn1 hn2 => hS n hn1 (by omega))
        (fun m' h1' h3' hlt => ihW m' h1' h3' (by omega))

/-! ## Main theorems -/

/-- **Farkas' weak 3x+1 conjecture** (Applegate–Lagarias, Theorem 1.1): every positive integer
lies in the 3x+1 semigroup `S`. -/
theorem weak_conjecture (n : ℕ) (hn : 1 ≤ n) : (n : ℚ) ∈ S3 := (main n).1 n hn le_rfl

/-- **Lagarias' wild numbers conjecture** (Applegate–Lagarias, Theorem 1.1): the integers in the
wild semigroup `W` are exactly the `m ≥ 1` with `3 ∤ m`. -/
theorem wild_numbers (m : ℕ) : (m : ℚ) ∈ Wild ↔ 1 ≤ m ∧ ¬ 3 ∣ m := by
  constructor
  · intro h
    have := S3_subset (mem_Wild_iff_inv_mem_S3.1 h)
    rcases Nat.eq_zero_or_pos m with rfl | hm
    · simp at this
    · rw [Rat.inv_natCast_den_of_pos hm] at this
      exact ⟨hm, this.2⟩
  · rintro ⟨h1, h3⟩
    exact (main (128 * m)).2 m h1 h3 le_rfl

/-- **Theorem 1.1** (Applegate–Lagarias): the 3x+1 semigroup `S` is exactly the set of positive
rationals `a/b` in lowest terms with `b ≢ 0 (mod 3)`. -/
theorem mem_S3_iff (q : ℚ) : q ∈ S3 ↔ 0 < q ∧ ¬ 3 ∣ q.den := by
  refine ⟨S3_subset, fun ⟨hq, hd⟩ => ?_⟩
  have hnum : 0 < q.num := Rat.num_pos.2 hq
  have e : (q.num.toNat : ℚ) * ((q.den : ℚ))⁻¹ = q := by
    rw [← Int.cast_natCast, Int.toNat_of_nonneg hnum.le, ← div_eq_mul_inv, Rat.num_div_den]
  rw [← e]
  exact mul_mem (weak_conjecture _ (by omega))
    (mem_Wild_iff_inv_mem_S3.1 ((wild_numbers _).2 ⟨q.den_pos, hd⟩))

end Collatz.ALSemigroup

