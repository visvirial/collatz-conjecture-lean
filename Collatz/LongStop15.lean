namespace Collatz

/-- **Infinitely many `n` need at least `≈ 5.789 log n` steps to reach `1`**:
`19 log n - 145 log 3 ≤ (19 log 2 - 9 log 3) σ(n)` with `σ(n) = L + 2` for every `L`. -/
theorem long_stopping_log_fifteen (L : ℕ) : ∃ n, 1 ≤ n ∧ kstepT^[L + 2] n = 1 ∧
    (∀ i < L + 2, kstepT^[i] n ≠ 1) ∧
    19 * Real.log n - 145 * Real.log 3 ≤ (19 * Real.log 2 - 9 * Real.log 3) * (L + 2 : ℕ) := by
  obtain ⟨n, h1, h2, h3, h4⟩ := long_stopping_log_gen (M := 14348907) (P := 9) (Q := 19) (H := 127)
    (by norm_num) (by norm_num) LS15.cert
    (fun r _ => by have := LSF.pot_lt LS15.pc 2187 7 r; norm_num at this; omega) L
  refine ⟨n, h1, h2, h3, ?_⟩
  norm_num at h4 ⊢
  linarith

end Collatz
