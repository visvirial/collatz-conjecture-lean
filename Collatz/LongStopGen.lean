import Collatz.LongStop
import Collatz.Kernel

/-!
# Longer trajectories from a larger potential (`γ > 5`)

`Collatz/LongStop.lean` with the modulus as a parameter. A potential `h` on the residues mod `M`
(`9 ∣ M`) is a certificate (`LSCert h M P Q`) if for every `t < 3M` prime to `3` the even backward
move gains `P`, or `t ≡ 2, 8 (mod 9)` and the odd backward move gains `P - Q`. Then every `L` has
an `n` with total stopping time exactly `L + 2` and `P L ≤ Q s + H` odd steps (`H` bounds `h`),
so `Q log n - (2P + H) log 3 ≤ (Q log 2 - P log 3) σ(n)`.

The instance uses `M = 3^10`, `P/Q = 9/20` and `H = 89` (`scripts/longstop_cert.py`, the
potential packed into one natural number with 7 bits per residue and checked by `decide +kernel`
in 27 pieces), so infinitely many `n` need `σ(n) ≥ γ log n - c` steps with
`γ = 1 / (log 2 - (9/20) log 3) ≈ 5.03`.
-/

namespace Collatz

/-- The certificate condition for a potential `h` on the residues mod `M`. -/
def LSCert (h : ℕ → ℕ) (M P Q : ℕ) : Prop :=
  ∀ t < 3 * M, t % 3 ≠ 0 → h (t % M) + P ≤ h (2 * t % M) ∨
    ((t % 9 = 2 ∨ t % 9 = 8) ∧ h (t % M) + P ≤ h ((2 * t - 1) / 3 % M) + Q)

/-- Backward paths with many odd moves, for any certificate. -/
theorem backward_path_gen {h : ℕ → ℕ} {M P Q : ℕ} (hM : 0 < M) (h9 : 9 ∣ M) (hc : LSCert h M P Q) :
    ∀ L a, a % 3 ≠ 0 → ∃ n, n % 3 ≠ 0 ∧ kstepT^[L] n = a ∧
      P * L + h (a % M) ≤ Q * oddCount L n + h (n % M)
  | 0, a, ha => ⟨a, ha, rfl, by simp [oddCount]⟩
  | L + 1, a, ha => by
    have h3M : M ∣ 3 * M := dvd_mul_left M 3
    have h93 : 9 ∣ 3 * M := h9.trans h3M
    set t := a % (3 * M) with ht
    have htlt : t < 3 * M := Nat.mod_lt _ (by omega)
    have e3 : t % 3 = a % 3 := Nat.mod_mod_of_dvd a (dvd_mul_right 3 M)
    have e9 : t % 9 = a % 9 := Nat.mod_mod_of_dvd a h93
    have eM : t % M = a % M := Nat.mod_mod_of_dvd a h3M
    have e2 : 2 * t % M = 2 * a % M := by rw [Nat.mul_mod, eM, ← Nat.mul_mod]
    have eo : (2 * t - 1) / 3 % M = (2 * a - 1) / 3 % M := by
      have hd : 3 * M * (a / (3 * M)) + t = a := Nat.div_add_mod a (3 * M)
      have : (2 * a - 1) / 3 = (2 * t - 1) / 3 + M * (2 * (a / (3 * M))) := by
        have h1 : 1 ≤ t := by omega
        have e : 3 * M * (a / (3 * M)) = 3 * (M * (a / (3 * M))) := by ring
        have e' : M * (2 * (a / (3 * M))) = 2 * (M * (a / (3 * M))) := by ring
        rw [e] at hd
        rw [e']
        generalize M * (a / (3 * M)) = Y at hd ⊢
        omega
      rw [this, Nat.add_mul_mod_self_left]
    have hct := hc t htlt (by omega)
    rw [eM, e2, eo, e9] at hct
    rcases hct with h' | ⟨h9', h'⟩
    · obtain ⟨n, hn3, hnT, hb⟩ := backward_path_gen hM h9 hc L (2 * a) (by omega)
      refine ⟨n, hn3, ?_, ?_⟩
      · rw [Function.iterate_succ_apply', hnT, kstepT_of_even (by omega)]; omega
      · rw [oddCount_succ, hnT, show 2 * a % 2 = 0 by omega, Nat.mul_succ, Nat.add_zero]
        omega
    · obtain ⟨n, hn3, hnT, hb⟩ := backward_path_gen hM h9 hc L ((2 * a - 1) / 3) (by omega)
      have hodd : (2 * a - 1) / 3 % 2 = 1 := by omega
      refine ⟨n, hn3, ?_, ?_⟩
      · rw [Function.iterate_succ_apply', hnT, kstepT_of_odd hodd]; omega
      · rw [oddCount_succ, hnT, hodd, Nat.mul_succ, Nat.mul_add, Nat.mul_one]
        omega

/-- **Long stopping times from any certificate.** -/
theorem exists_long_stopping_gen {h : ℕ → ℕ} {M P Q H : ℕ} (hM : 0 < M) (h9 : 9 ∣ M) (hc : LSCert h M P Q)
    (hH : ∀ r < M, h r ≤ H) (L : ℕ) : ∃ n, kstepT^[L + 2] n = 1 ∧
      (∀ i < L + 2, kstepT^[i] n ≠ 1) ∧ P * L ≤ Q * oddCount L n + H ∧
      3 ^ oddCount L n * n ≤ 2 ^ (L + 2) := by
  obtain ⟨n, -, hnT, hb⟩ := backward_path_gen hM h9 hc L 4 (by norm_num)
  have h4 : kstepT 4 = 2 := rfl
  have h2 : kstepT 2 = 1 := rfl
  have hlh := hH (n % M) (Nat.mod_lt _ hM)
  refine ⟨n, ?_, ?_, by omega, ?_⟩
  · rw [Function.iterate_succ_apply', Function.iterate_succ_apply', hnT, h4, h2]
  · intro i hi h1
    rcases Nat.lt_or_ge i (L + 1) with hiL | hiL
    · have : kstepT^[L] n = kstepT^[L - i] 1 := by
        rw [← h1, ← Function.iterate_add_apply, Nat.sub_add_cancel (by omega)]
      rw [hnT] at this
      rcases iterate_one_mem (L - i) with h | h <;> omega
    · rw [show i = L + 1 by omega, Function.iterate_succ_apply', hnT, h4] at h1
      omega
  · have := iterate_lower n L
    rw [hnT] at this
    calc 3 ^ oddCount L n * n ≤ 2 ^ L * 4 := this
      _ = 2 ^ (L + 2) := by ring

/-- The logarithmic form: `Q log n - (2P + H) log 3 ≤ (Q log 2 - P log 3) σ` with `σ = L + 2`. -/
theorem long_stopping_log_gen {h : ℕ → ℕ} {M P Q H : ℕ} (hM : 0 < M) (h9 : 9 ∣ M) (hc : LSCert h M P Q)
    (hH : ∀ r < M, h r ≤ H) (L : ℕ) : ∃ n, 1 ≤ n ∧ kstepT^[L + 2] n = 1 ∧
      (∀ i < L + 2, kstepT^[i] n ≠ 1) ∧
      Q * Real.log n - (2 * P + H) * Real.log 3 ≤
        (Q * Real.log 2 - P * Real.log 3) * (L + 2 : ℕ) := by
  obtain ⟨n, h1, hne, hodd, hsize⟩ := exists_long_stopping_gen hM h9 hc hH L
  have hn : 1 ≤ n := by
    rcases Nat.eq_zero_or_pos n with h0 | h0
    · subst h0
      have : kstepT^[L + 2] 0 = 0 := Function.iterate_fixed rfl _
      omega
    · exact h0
  refine ⟨n, hn, h1, hne, ?_⟩
  set s := oddCount L n
  have hsR : ((3 : ℝ) ^ s * n) ≤ 2 ^ (L + 2) := by exact_mod_cast hsize
  have hl := Real.log_le_log (by positivity) hsR
  rw [Real.log_mul (by positivity) (by exact_mod_cast (show n ≠ 0 by omega)), Real.log_pow,
    Real.log_pow] at hl
  have hoddR : (P * L : ℝ) ≤ Q * s + H := by exact_mod_cast hodd
  have h3 : 0 < Real.log 3 := Real.log_pos (by norm_num)
  have hQ : (0 : ℝ) ≤ Q := by positivity
  push_cast at hl ⊢
  nlinarith [mul_le_mul_of_nonneg_right hoddR h3.le, mul_le_mul_of_nonneg_left hl hQ]

/-! ## The instance mod `3^10` -/

/-- Entry `r` of a table packed with `w` bits per entry. -/
def lsTab (B w r : ℕ) : ℕ := (B >>> (w * r)) % 2 ^ w

/-- The certificate condition at `t`, as a `Bool`. -/
def lsOk (B w M P Q t : ℕ) : Bool :=
  t % 3 == 0 || Nat.ble (lsTab B w (t % M) + P) (lsTab B w (2 * t % M)) ||
    ((t % 9 == 2 || t % 9 == 8) &&
      Nat.ble (lsTab B w (t % M) + P) (lsTab B w ((2 * t - 1) / 3 % M) + Q))

lemma lsCert_of_kall {B w M P Q : ℕ} (hk : kall (lsOk B w M P Q) (3 * M) = true) :
    LSCert (lsTab B w) M P Q := by
  intro t ht h3
  have := kall_spec hk t ht
  simp only [lsOk, Bool.or_eq_true, Bool.and_eq_true, beq_iff_eq, Nat.ble_eq] at this
  omega

